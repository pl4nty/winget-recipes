{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.airytec.com/en/switch-off/history.aspx",
		"regex": "<b>Switch Off (?<version>\\d+(?:\\.\\d+)+)</b>[\\s\\S]*?<a href=\"(?<path>/files/[^\"]+\\.exe)\""
	},
	"urls": [
		"https://www.airytec.com{captures.path}"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.airytec.com/switch-off/history.aspx"
	},
	"replace": true
}
