{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vma-broadcast.com/download/",
		"regex": "/wp-content/uploads/(?<path>\\d{4}/\\d{2}/VMA-Spectrum-Analyser-for-TinySA-(?<version>\\d{4}-\\d{2}-\\d{2})\\.zip)"
	},
	"urls": [
		{
			"url": "https://vma-broadcast.com/wp-content/uploads/{captures.path}",
			"architecture": "x86",
			"nestedInstallerMatches": ["VMA Spectrum Analyser for TinySA.exe"]
		}
	]
}
