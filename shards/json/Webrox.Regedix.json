{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://regedix.webrox.fr/",
		"regex": "download\\.php\\?v=(?<version>\\d+(?:\\.\\d+)+)&file=[\\d.]+/Regedix-(?<short>\\d+(?:\\.\\d+)+)-x64\\.exe"
	},
	"urls": [
		{ "url": "https://regedix.webrox.fr/download.php?v={version}&file={version}/Regedix-{captures.short}-x86.exe", "architecture": "x86" },
		{ "url": "https://regedix.webrox.fr/download.php?v={version}&file={version}/Regedix-{captures.short}-x64.exe", "architecture": "x64" }
	]
}
