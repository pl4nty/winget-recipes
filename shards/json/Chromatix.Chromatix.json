{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "chromatix-app",
		"repo": "chromatix-release",
		"method": "api-sort",
		"assetRegex": "^(?:Chromatix\\-Setup\\-\\d+\\.\\d+\\.\\d+\\.exe)$"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/chromatix-app/chromatix-release/releases/tag/{github.rawTag}"
	}
}
