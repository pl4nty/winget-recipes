{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.hec.usace.army.mil/software/hec-hms/downloads.aspx",
		"regex": "releases/download/(?<tag>[\\d.]+)/HEC-HMS_(?<file>\\d+)_Setup\\.exe\"><span class=\"fas fa-download\"></span> Download</a> HEC-HMS (?<version>\\d+(?:\\.\\d+)+) for Windows"
	},
	"urls": [
		"https://github.com/HydrologicEngineeringCenter/hec-downloads/releases/download/{captures.tag}/HEC-HMS_{captures.file}_Setup.exe"
	],
	"releaseNotes": {
		"source": "github",
		"owner": "HydrologicEngineeringCenter",
		"repo": "hec-downloads",
		"tag": "{captures.tag}",
		"cleanup": false
	}
}
