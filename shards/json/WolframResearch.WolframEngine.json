{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://account.wolfram.com/dl/WolframEngine?platform=Windows"
		],
		"regex": "/WolframEngine/(?<full>(?<version>\\d+\\.\\d+\\.\\d+)(?:\\.\\d+)?)/"
	},
	"urls": [
		"https://files.wolframcdn.com/packages/winget/{captures.full}/WolframEngine_{version}_WIN.zip"
	]
}
