	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://www.linqpad.net/GetFile.aspx?LINQPad6Setup.exe"
		],
		"regex": "/LINQPad6Setup\\.exe\\?cache=(?<version>\\d+\\.\\d+\\.\\d+)\\.(?<build>\\d+)$"
