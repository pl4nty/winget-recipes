{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.tweaknow.com/WindowsSecretPlus.php",
		"regex": "<p>\\s*Version (\\d+(?:\\.\\d+)+) \\("
	},
	"urls": ["https://tweaknow.com/Downloads/WinSecret{version|.|}.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.tweaknow.com/WhatsNew.php"
	},
	"cleanup": false
}
