{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.oracle.com/java/technologies/javase/jdk22-archive-downloads.html",
		"regex": "download\\.oracle\\.com/java/22/archive/jdk-(?<version>22\\.\\d+\\.\\d+)_windows-x64_bin\\.msi"
	},
	"version": "{version}.0",
	"urls": [
		"https://download.oracle.com/java/22/archive/jdk-{captures.version}_windows-x64_bin.msi",
		"https://download.oracle.com/java/22/archive/jdk-{captures.version}_windows-x64_bin.exe"
	]
}
