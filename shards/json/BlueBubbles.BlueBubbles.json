{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "BlueBubblesApp",
		"repo": "bluebubbles-app",
		"method": "api-list",
		"tagRegex": "\\+desktop\\..*$"
	},
	"urls": [
		"https://github.com/BlueBubblesApp/bluebubbles-app/releases/download/{github.rawTag}/bluebubbles_installer.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/BlueBubblesApp/bluebubbles-app/releases/tag/{github.rawTag}"
	}
}
