{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/kdiff3/rss?path=/kdiff3",
		"regex": "/kdiff3/(?<version>\\d+(?:\\.\\d+)+)/KDiff3-64bit-Setup_\\d+(?:\\.\\d+)+(?<rel>(?:-\\d+)?)\\.exe"
	},
	"urls": [
		"https://sourceforge.net/projects/kdiff3/files/kdiff3/{version}/KDiff3-64bit-Setup_{version}{captures.rel}.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://sourceforge.net/projects/kdiff3/files/kdiff3/{version}/"
	}
}
