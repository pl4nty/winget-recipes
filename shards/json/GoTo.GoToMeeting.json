{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://link.gotomeeting.com/latest-msi"
		],
		"regex": "/builds/g2m/(?<build>\\d+)/G2MSetup(?<major>\\d+)\\.(?<minor>\\d+)\\.\\k<build>_IT\\.msi"
	},
	"version": "{captures.major}.{captures.minor}.0.{captures.build}"
}
