{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "prusa3d",
		"repo": "PrusaSlicer",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "^v?ersion_"
	},
	"urls": [
		{
			"url": "https://github.com/prusa3d/PrusaSlicer/releases/download/{github.rawTag}/PrusaSlicer-{version}.zip",
			"architecture": "x64"
		}
	]
}
