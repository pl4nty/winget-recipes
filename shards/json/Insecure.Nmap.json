{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://nmap.org/download.html",
		"regex": "nmap-(\\d+\\.\\d+)-setup\\.exe"
	},
	"urls": ["https://nmap.org/dist/nmap-{version}-setup.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://nmap.org/changelog.html"
	}
}
