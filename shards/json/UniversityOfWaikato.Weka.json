{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/weka/rss",
		"regex": "/files/(?<dir>weka-\\d+-\\d+)/(?<version>\\d+(?:\\.\\d+)+)/weka-[\\d-]+-azul-zulu-windows\\.exe/download"
	},
	"urls": [
		"https://sourceforge.net/projects/weka/files/{captures.dir}/{version}/weka-{version|.|-}-azul-zulu-windows.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://ml.cms.waikato.ac.nz/weka/downloading"
	}
}
