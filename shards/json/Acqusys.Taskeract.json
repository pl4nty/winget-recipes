{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.taskeract.com/changelog",
		"regex": "taskeract-app/releases/tag/v(\\d+\\.\\d+\\.\\d+)\""
	},
	"urls": [
		"https://f001.backblazeb2.com/file/taskeract-pub/releases/v{version}/Taskeract_{version}_x64-setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.taskeract.com/changelog"
	}
}
