{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://deviceshelf.app",
		"regex": "/DeviceShelf\\-(\\d+(?:\\.\\d+)+)\\-setup\\.exe"
	},
