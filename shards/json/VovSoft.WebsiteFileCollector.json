{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/website-file-collector/",
		"regex": "<span class=\"notranslate\">Website File Collector (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/website-file-collector.exe", "https://files.vovsoft.com/website-file-collector-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/website-file-collector/"
	}
}
