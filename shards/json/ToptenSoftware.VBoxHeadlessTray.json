{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.toptensoftware.com/vboxheadlesstray/",
		"regex": "VBoxHeadlessTray(\\d)(?<minor>\\d)(?<patch>\\d)Setup\\.exe"
	},
	"version": "{version}.{captures.minor}.{captures.patch}",
	"urls": [
		"https://static.toptensoftware.com/VBoxHeadlessTray{version}{captures.minor}{captures.patch}Setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.toptensoftware.com/vboxheadlesstray/"
	}
}
