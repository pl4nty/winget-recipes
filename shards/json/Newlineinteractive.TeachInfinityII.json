{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://newline-interactive.com/apac/products/teach-infinity/",
		"regex": "/wp-content/uploads/(?<path>\\d{4}/\\d{2})/Teach-Infinity-II-v-(?<version>\\d+(?:\\.\\d+)+)\\.(?<build>[^\"'/]*?)\\.exe\\.zip"
	},
	"urls": [
		{
			"url": "https://newline-interactive.com/wp-content/uploads/{captures.path}/Teach-Infinity-II-v-{version}.{captures.build}.exe.zip",
			"nestedInstallerMatches": [
				"Teach Infinity II v "
			]
		}
	]
}
