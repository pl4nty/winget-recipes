{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://newline-interactive.com/products/teach-infinity/",
		"regex": "wp-content/uploads/(?<dir>\\d{4}/\\d{2})/Teach-Infinity-II-v-(?<version>\\d+(?:\\.\\d+)+)\\.(?<build>[\\w.]+?)\\.exe\\.zip"
	},
	"urls": [
		{
			"url": "https://newline-interactive.com/wp-content/uploads/{captures.dir}/Teach-Infinity-II-v-{version}.{captures.build}.exe.zip",
			"architecture": "x86"
		}
	]
}
