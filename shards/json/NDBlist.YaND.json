{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ndblist.info/datamodes.htm",
		"regex": "href=\"index_htm_files/(?<file>YaNDsetup(?<version>\\d+(?:_\\d+)+)\\.exe)\""
	},
