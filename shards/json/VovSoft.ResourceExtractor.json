{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/resource-extractor/",
		"regex": "<span class=\"notranslate\">Resource Extractor (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/resource-extractor.exe", "https://files.vovsoft.com/resource-extractor-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/resource-extractor/"
	}
}
