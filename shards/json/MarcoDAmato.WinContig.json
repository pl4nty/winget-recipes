{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.mdtzone.it/sw/wincontig/en/index.html",
		"regex": "Version <b>(?<version>\\d+(?:\\.\\d+)+)</b>"
	},
	"urls": [
		{
			"url": "https://www.mdtzone.it/Files/WContig.zip",
			"architecture": "neutral",
			"nestedInstallerMatches": ["WinContig.exe"]
		},
		{
			"url": "https://www.mdtzone.it/Files/WContig.zip",
			"architecture": "x86",
			"nestedInstallerMatches": ["WinContig32.exe"]
		}
	]
}
