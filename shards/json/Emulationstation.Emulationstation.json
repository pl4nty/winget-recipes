{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://emulationstation.org/downloads.html",
		"regex": "downloads/releases/(?<dir>[^/\"]+)/emulationstation_(?<version>\\d+(?:\\.\\d+)+[a-z]?)_win32\\.exe"
	},
	"urls": ["https://emulationstation.org/downloads/releases/{captures.dir}/emulationstation_{version}_win32.exe"]
}
