{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/hex-viewer/",
		"regex": "<span class=\"notranslate\">Hex Viewer (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/hex-viewer.exe", "https://files.vovsoft.com/hex-viewer-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/hex-viewer/"
	}
}
