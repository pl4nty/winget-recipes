{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://chuck.stanford.edu/release/",
		"regex": "href=\"files/exe/chuck-(\\d+(?:\\.\\d+)+)\\.msi\""
	},
