{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://gitlab.com/api/v4/projects/ImaginaryInfinity%2Fsquiid-calculator%2Fsquiid/releases?per_page=1",
		"regex": "\"tag_name\":\"(?<tag>v?(?<version>[^\"]+))\"[\\s\\S]*?\"url\":\"(?<url>[^\"]*/squiid-installer\\.exe)\""
	},
	"urls": [
		{
			"url": "{captures.url}",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://gitlab.com/ImaginaryInfinity/squiid-calculator/squiid/-/releases/{captures.tag}"
	}
}
