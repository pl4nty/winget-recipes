{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://gitlab.com/api/v4/projects/bztsrc%2Fusbimager/repository/tags?per_page=100",
		"regex": "\"name\":\"(\\d+(?:\\.\\d+)+)\""
	},
	"urls": ["https://gitlab.com/bztsrc/usbimager/raw/binaries/usbimager_{version}_wo-i686-win-gdi.zip"],
