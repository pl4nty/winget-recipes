{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://downloads.focusrite.com/novation/launchpad-mk2/launchpad-mini-mk2",
		"regex": "/downloads/(?<file>novationusbmidi_(?<version>\\d+\\.\\d+\\.\\d+_\\d+)\\.exe)"
	},
	"version": "{version|_|.}",
	"urls": [
		"https://fael-downloads-prod.focusrite.com/customer/prod/downloads/{captures.file}"
	]
}
