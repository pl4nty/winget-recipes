{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/clipboard-reader/",
		"regex": "<span class=\"notranslate\">Clipboard Reader (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/clipboard-reader.exe", "https://files.vovsoft.com/clipboard-reader-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/clipboard-reader/"
	}
}
