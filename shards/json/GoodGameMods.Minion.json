{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://minion.mmoui.com/?download",
		"regex": "cdn\\.mmoui\\.com/minion/(?<dir>v\\d+)/Minion(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		"https://cdn.mmoui.com/minion/{captures.dir}/Minion{version}.exe"
	],
	"releaseNotes": {
