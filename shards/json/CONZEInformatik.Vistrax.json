{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vistrax.com/update/",
		"regex": "/wp-content/files/software/vistrax_setup_(?<version>\\d+(?:\\.\\d+)+)\\.zip"
	},
	"urls": [
		"https://vistrax.com/wp-content/files/software/vistrax_setup_{version}.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://vistrax.com/update/"
	}
}
