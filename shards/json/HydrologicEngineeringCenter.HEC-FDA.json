{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.hec.usace.army.mil/software/hec-fda/downloads.aspx",
		"regex": "href=\"downloads/(?<file>HEC-FDA_\\d+_Setup\\.exe)\"><span class=\"fas fa-download\"></span> Download</a> HEC-FDA Version\\s+(?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [{ "url": "https://www.hec.usace.army.mil/software/hec-fda/downloads/{captures.file}", "architecture": "x64" }]
}
