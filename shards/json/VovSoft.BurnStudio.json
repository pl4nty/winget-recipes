{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/burn-studio/",
		"regex": "<span class=\"notranslate\">Burn Studio (?<version>\\d+\\.\\d+)</span>"
	},
