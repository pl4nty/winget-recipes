{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.mitec.cz/wp/xml/vh_tmx.xml",
		"regex": "<VERSION>(\\d+(?:\\.\\d+)+)</VERSION>"
	},
	"urls": [
		{
			"url": "https://www.mitec.cz/wp/files/TMX.zip",
			"nestedInstallerMatches": [
				"TMX.exe",
				"DeskExp.exe"
			]
		},
		{
			"url": "https://www.mitec.cz/wp/files/TMX.zip",
			"nestedInstallerMatches": [
				"TMX64.exe",
				"DeskExp64.exe"
			]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.mitec.cz/wp/xml/vh_tmx.xml"
	}
}
