{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.atlantiswordprocessor.com/en/news/release_notes.php",
		"regex": "<a href=\"(?<version>(?<major>\\d+)_(?<minor>\\d+)_(?<patch>\\d+)_0*(?<build>\\d+))\\.htm\"><b>"
	},
	"version": "{captures.major}.{captures.minor}.{captures.patch}.{captures.build}",
	"urls": [
		"https://www.atlantiswordprocessor.com/download/awp_setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.atlantiswordprocessor.com/en/news/{version}.htm"
	}
}
