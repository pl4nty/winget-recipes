{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/regex-extractor/",
		"regex": "<span class=\"notranslate\">RegEx Extractor (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/regex-extractor.exe", "https://files.vovsoft.com/regex-extractor-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/regex-extractor/"
	}
}
