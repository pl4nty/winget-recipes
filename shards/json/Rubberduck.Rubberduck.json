{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "rubberduck-vba",
		"repo": "Rubberduck",
		"method": "api-latest",
		"assetRegex": "^Rubberduck\\.Setup\\.\\d+(?:\\.\\d+)+\\.exe$"
	},
	"version": {
		"source": "product"
	},
	"state": {
		"source": "value",
		"value": "{github.rawTag}"
	}
}
