{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://rii7.com/volume-hotkeys/",
		"regex": "/assets/file/vh_(?<version>\\d+(?:\\.\\d+)+)\\.zip"
	},
	"urls": [
		{
			"url": "https://rii7.com/assets/file/vh_{version}.zip",
			"architecture": "x86",
			"nestedInstallerMatches": ["Volume Hotkeys.exe"]
		}
	]
}
