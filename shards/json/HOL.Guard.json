{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://hol.org/api/guard/desktop/download?platform=windows"
		],
		"regex": "filename%3DHOL-Guard-Desktop-(\\d+(?:\\.\\d+)+)-x64\\.msi"
	},
	"urls": [
		"https://hol.org/api/guard/desktop/download?platform=windows&version={version}"
	]
}
