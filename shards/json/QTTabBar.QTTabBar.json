{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/qttabbar/rss",
		"regex": "/files/(?<dir>[^/<]+)/qttabbar-v(?<version>[^/<]+)\\.msi/download"
	},
	"version": {
		"source": "display"
	},
	"urls": [
		{
			"url": "https://sourceforge.net/projects/qttabbar/files/{captures.dir}/qttabbar-v{version}.msi/download",
			"architecture": "x86"
		}
	]
}
