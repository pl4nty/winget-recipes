{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.allen-heath.com/dlive-home/software",
		"regex": "content/uploads/(?<path>\\d{4}/\\d{2})/dLive-Director-V(?<version>\\d+\\.\\d+)-Installer\\.zip"
	},
	"version": "V{version}",
	"urls": ["https://www.allen-heath.com/content/uploads/{captures.path}/dLive-Director-V{version}-Installer.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.allen-heath.com/dlive-home/software"
	}
}
