{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.spelunkyworld.com/original.html",
		"regex": "derekyu\\.com/games/spelunky_(?<major>\\d+)_(?<minor>\\d+)\\.zip"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		"https://www.derekyu.com/games/spelunky_{captures.major}_{captures.minor}.zip"
	]
}
