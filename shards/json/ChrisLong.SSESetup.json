{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ssesetup.com/download.html",
		"regex": "(?<file>SSESetup(?<version>\\d+-\\d+)\\.exe)"
	},
	"version": "{version|-|.}",
	"urls": [
		{
			"url": "https://www.ssesetup.com/downloads/{captures.file}",
			"architecture": "x86"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ssesetup.com/changelog.html"
	}
}
