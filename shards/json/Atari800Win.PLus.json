{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://atari.org.pl/PLus/downloads_us.htm",
		"regex": "files/Atari800Win PLus (\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		{
			"url": "https://atari.org.pl/PLus/files/Atari800Win%20PLus%20{version}.exe",
			"architecture": "x86"
		},
		{
			"url": "https://atari.org.pl/PLus/files/Atari800Win%20PLus%20{version}.zip",
			"architecture": "x86"
		}
	]
}
