{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/vcf-merger/",
		"regex": "<span class=\"notranslate\">VCF Merger (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/vcf-merger.exe", "https://files.vovsoft.com/vcf-merger-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/vcf-merger/"
	}
}
