{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://nakka.com/soft/clcl/index_eng.html",
		"regex": "CLCL Ver (\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{
			"url": "https://nakka.com/soft/clcl/download/clcl{version|.|}.zip",
			"nestedInstallerMatches": ["clcl.exe", "clclset.exe"]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://nakka.com/soft/clcl/index_eng.html"
	}
}
