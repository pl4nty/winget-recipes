{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://neverball.org/download",
		"regex": "href=\"neverball-(\\d+(?:\\.\\d+)+)\\.zip\""
	},
	"urls": [
		{
			"url": "https://neverball.org/neverball-{version}.zip",
			"architecture": "x86",
			"nestedInstallerMatches": [
				"/neverball.exe"
			]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://neverball.org/"
	}
}
