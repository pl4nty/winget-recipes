{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "SosomLab",
		"repo": "nexa-beep",
		"method": "api-sort",
		"tagRegex": "^beepd-v",
		"perPage": 100
	},
	"urls": [
		{
			"url": "https://github.com/SosomLab/nexa-beep/releases/download/{github.rawTag}/nexa-beepd-{version}-windows-x64.zip",
			"architecture": "x64",
			"nestedInstallerMatches": ["nexa-beepd.exe"]
		}
	]
}
