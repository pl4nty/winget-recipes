{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://download.pdfforge.org/download/pdfcreator-server/list",
		"regex": "/download/pdfcreator-server/(\\d+(?:\\.\\d+)+)/PDFCreator-Server-[\\d_]+-Setup\\.exe"
	},
	"urls": [
		"https://cdn.download.pdfforge.org/pdfcreator-server/{version}/PDFCreator-Server-{version|.|_}-Setup.exe"
	]
}
