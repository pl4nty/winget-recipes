{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"version": {
		"source": "display"
	},
	"github": {
		"owner": "ojdkbuild",
		"repo": "ojdkbuild",
		"tagRegex": "^java-17-openjdk-(?=\\d)"
	},
	"urls": [
		"https://github.com/ojdkbuild/ojdkbuild/releases/download/{github.rawTag|-debug-|-}/{github.rawTag|-debug-|-}.jre.win.x86_64.msi"
	]
}
