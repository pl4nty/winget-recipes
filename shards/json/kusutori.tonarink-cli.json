{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "kusutori",
		"repo": "Tonarink",
		"method": "api-list",
		"kind": "all",
		"tagRegex": "^cli-v"
	},
	"urls": [
