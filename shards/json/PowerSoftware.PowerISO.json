{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.poweriso.com/tutorials/history.htm",
		"regex": "<b>PowerISO (?<version>(?<major>\\d+)\\.\\d+(?:\\.\\d+)?)</b>"
	},
	"version": "{version}.0.0",
	"urls": [
		{ "url": "https://www.poweriso.com/PowerISO{captures.major}.exe", "architecture": "x86" },
		{ "url": "https://www.poweriso.com/PowerISO{captures.major}-x64.exe", "architecture": "x64" },
		{ "url": "https://www.poweriso.com/arm64_poweriso_setup.exe", "architecture": "arm64" }
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.poweriso.com/tutorials/history.htm"
	},
	"replace": true
}
