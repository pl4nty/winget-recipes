{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ideagenthub.com/changelog",
		"regex": "releases\\.ideagenthub\\.com/IDEAgentHub-(\\d+(?:\\.\\d+)+)-Setup\\.exe"
	},
	"urls": [
		"https://releases.ideagenthub.com/IDEAgentHub-{version}-Setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ideagenthub.com/changelog"
	}
}
