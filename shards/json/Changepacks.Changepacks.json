{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "changepacks",
		"repo": "changepacks",
		"method": "api-list",
		"tagRegex": "^changepacks\\(crates/changepacks/Cargo\\.toml\\)@",
		"perPage": 100
	},
	"urls": [
		"https://github.com/changepacks/changepacks/releases/download/{github.rawTag}/changepacks-windows-x86_64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/changepacks/changepacks/releases/tag/{github.rawTag}"
	}
}
