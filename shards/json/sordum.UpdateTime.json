{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.sordum.org/9203/",
		"regex": "<title>Update Time v(?<version>\\d+(?:\\.\\d+)+)[\\s\\S]*?<link rel=\"canonical\" href=\"(?<page>https://www\\.sordum\\.org/9203/update-time-v[^\"]*)\""
	},
	"urls": [
		{
			"url": "https://www.sordum.org/files/download/update-time/UpdateTime.zip",
			"architecture": "x86",
			"nestedInstallerMatches": ["UpdateTime/UpdateTime.exe"]
		},
		{
			"url": "https://www.sordum.org/files/download/update-time/UpdateTime.zip",
			"architecture": "x64",
			"nestedInstallerMatches": ["UpdateTime/UpdateTime_x64.exe"]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "{captures.page}"
	},
	"replace": true
}
