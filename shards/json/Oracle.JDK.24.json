{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.oracle.com/java/technologies/javase/jdk24-archive-downloads.html",
		"regex": "/java/24/archive/jdk-(24(?:\\.\\d+)*)_windows-x64_bin\\.msi"
	},
	"version": "{version}.0",
	"urls": [
		"https://download.oracle.com/java/24/archive/jdk-{version}_windows-x64_bin.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.oracle.com/java/technologies/javase/24-relnote-issues.html"
	}
}
