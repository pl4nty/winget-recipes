{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.httpmaster.net/download",
		"regex": "/downloads/httpmaster_x64_(\\d+(?:\\.\\d+)+)\\.msi"
	},
	"urls": [
		{
			"url": "https://www.httpmaster.net/downloads/httpmaster_x64_{version}.msi",
			"architecture": "x64"
		},
		{
			"url": "https://www.httpmaster.net/downloads/httpmaster_arm64_{version}.msi",
			"architecture": "arm64"
		}
	]
}
