{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://files.clpm.dev/clpm/",
		"regex": "clpm-(\\d+(?:\\.\\d+)+)-windows-amd64\\.zip"
	},
	"urls": [
		{
			"url": "https://files.clpm.dev/clpm/clpm-{version}-windows-amd64.zip",
			"nestedInstallerMatches": [
				"clpm-{version}\\bin\\clpm.exe"
			]
		}
	],
	"cleanup": false
}
