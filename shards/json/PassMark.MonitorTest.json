{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.passmark.com/products/monitortest/",
		"regex": "V(?<major>\\d+\\.\\d+)\\s+build\\s+(?<build>\\d+)"
	},
	"version": "{captures.major}.{captures.build}",
	"urls": [
		"https://www.passmark.com/downloads/montest.exe"
	],
	"state": {
		"source": "response-header",
		"url": "https://www.passmark.com/downloads/montest.exe",
		"header": "etag"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://www.passmark.com/products/monitortest/"
	},
	"replace": true
}
