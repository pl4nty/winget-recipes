{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://uz7.ho.ua/packetradio.htm",
		"regex": "modem_beta/soundmodem(?<major>\\d)(?<minor>\\d{2})\\.zip"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		"https://uz7.ho.ua/modem_beta/soundmodem{captures.major}{captures.minor}.zip"
	]
}
