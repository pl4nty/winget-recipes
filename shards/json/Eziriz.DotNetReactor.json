{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.eziriz.com/reactor_download.htm",
		"regex": "download=dotnet_reactor_setup_(?<raw>\\d+(?:_\\d+)+)\\.exe"
	},
	"version": "{version|_|.}",
	"urls": ["https://cdn-downloads.eziriz.com/dotnet_reactor_setup_{captures.raw}.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.eziriz.com/reactor_history.htm"
	}
}
