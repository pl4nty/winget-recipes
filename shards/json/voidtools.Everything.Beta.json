{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.voidtools.com/everything-1.5a/",
		"regex": "Everything-(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+[a-z]*)\\.x64-Setup\\.exe"
	},
	"urls": [
		{ "url": "https://www.voidtools.com/Everything-{version}.x86.zip", "architecture": "x86" },
		{ "url": "https://www.voidtools.com/Everything-{version}.x86-Setup.exe", "architecture": "x86" },
		{ "url": "https://www.voidtools.com/Everything-{version}.x64.zip", "architecture": "x64" },
		{ "url": "https://www.voidtools.com/Everything-{version}.x64-Setup.exe", "architecture": "x64" }
	]
}
