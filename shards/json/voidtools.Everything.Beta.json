		{ "url": "https://www.voidtools.com/Everything-{version}.x64-Setup.msi", "architecture": "x64" },
		{ "url": "https://www.voidtools.com/Everything-{version}.ARM.zip", "architecture": "arm" },
		{ "url": "https://www.voidtools.com/Everything-{version}.ARM-Setup.exe", "architecture": "arm" },
		{ "url": "https://www.voidtools.com/Everything-{version}.ARM64.zip", "architecture": "arm64" },
		{ "url": "https://www.voidtools.com/Everything-{version}.ARM64-Setup.exe", "architecture": "arm64" }
