{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "neokapi",
		"repo": "neokapi",
		"method": "api-list",
		"tagRegex": "^v(?=\\d+\\.\\d+\\.\\d+$)"
	},
	"urls": [
		"https://github.com/neokapi/neokapi/releases/download/{github.rawTag}/kapi-cli_{version}_windows_amd64.zip",
		"https://github.com/neokapi/neokapi/releases/download/{github.rawTag}/kapi-cli_{version}_windows_arm64.zip"
	]
}
