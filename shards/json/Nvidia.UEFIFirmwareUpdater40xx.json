{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://nvidia.custhelp.com/app/answers/detail/a_id/5411",
		"regex": "url=/Windows/uefi/firmware/(?<dir>\\d+(?:\\.\\d+)*)/NVIDIA_UEFI_Firmware_Updater_(?<version>\\d+(?:\\.\\d+)+)-x64\\.exe"
	},
	"version": "{version}.0",
	"urls": [
		"https://us.download.nvidia.com/Windows/uefi/firmware/{captures.dir}/NVIDIA_UEFI_Firmware_Updater_{version}-x64.exe"
	]
}
