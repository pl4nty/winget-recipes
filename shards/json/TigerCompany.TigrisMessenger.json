{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.tigrison.com/home",
		"regex": "testVersion = '[^']*';\\s+prodVersion = '(\\d+(?:\\.\\d+)+)'"
	},
	"urls": ["https://www.tigrison.com/store/messenger/update/packages/{version}/TigrisMessenger-Setup-{version}.exe"]
}
