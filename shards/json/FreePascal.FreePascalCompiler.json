{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://sourceforge.net/projects/freepascal/rss?path=/Win32",
		"regex": "/files/Win32/(\\d+(?:\\.\\d+)+)/fpc-\\d+(?:\\.\\d+)+\\.win32\\.and\\.win64\\.exe/download"
	},
	"urls": [
		"https://sourceforge.net/projects/freepascal/files/Win32/{version}/fpc-{version}.win32.and.win64.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://wiki.freepascal.org/User_Changes_{version}"
	}
}
