{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.softwarecompanions.com/proupdate.html",
		"regex": "Version (?<major>\\d+)\\.(?<minor>\\d+)"
	},
	"version": {
		"source": "product"
	},
	"urls": [
		"https://www.softwarecompanions.no/vc{captures.major}/vcpro{captures.major}{captures.minor}.exe",
		"https://www.softwarecompanions.no/vc{captures.major}/vcpro{captures.major}{captures.minor}x64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.softwarecompanions.com/proupdate.html"
	}
}
