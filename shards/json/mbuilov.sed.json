{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "mbuilov",
		"repo": "sed-windows",
		"method": "api-sort",
		"tagRegex": "^sed-"
	},
	"urls": [
		"https://github.com/mbuilov/sed-windows/releases/download/{github.rawTag}/sed-{version}-x86.exe",
		"https://github.com/mbuilov/sed-windows/releases/download/{github.rawTag}/sed-{version}-x64.exe"
	]
}
