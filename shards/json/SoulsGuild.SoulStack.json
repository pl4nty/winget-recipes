{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "souls-guild",
		"repo": "soul-stack",
		"method": "api-list",
		"kind": "all",
		"tagRegex": "^v(?=\\d)"
	},
	"urls": [
		"https://github.com/souls-guild/soul-stack/releases/download/v{version}/soul-stack_{version}_windows_arm64.zip",
		"https://github.com/souls-guild/soul-stack/releases/download/v{version}/soul-stack_{version}_windows_amd64.zip"
	]
}
