{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.acdsee.com/en/products/photo-studio-ultimate/",
		"regex": "dl\\.acdsystems\\.com/acdsee/en/(?<file>acdsee-photo-studio-ultimate-(?<version>\\d+(?:-\\d+)+)-win-en\\.exe)"
	},
	"version": {
		"source": "product"
	},
	"urls": [
		"https://dl.acdsystems.com/acdsee/en/{captures.file}"
	],
