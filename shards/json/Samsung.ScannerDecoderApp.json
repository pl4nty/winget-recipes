		"regex": "\"fileName\":\"QRBarcodeScanner_SDK_[^\"]+\\.zip\"[^}]*?\"fileVersion\":\"(?<version>[^\"]+)\"[^}]*?\"filePath\":\"(?<path>[^\"]+\\.zip)\""
