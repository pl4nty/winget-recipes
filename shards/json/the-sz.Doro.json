{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://the-sz.com/products/doro/",
		"regex": "Product: 'doro', Link[^>]*title=\"Version (\\d+\\.\\d+) &middot;"
	},
