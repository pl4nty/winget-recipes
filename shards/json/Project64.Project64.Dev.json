{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.pj64-emu.com/nightly-builds",
		"regex": "/file/setup-project64-dev-(?<a>\\d+)-(?<b>\\d+)-(?<c>\\d+)-(?<d>\\d+)-(?<hash>[0-9a-f]+)/"
	},
	"version": "{captures.a}.{captures.b}.{captures.c}.{captures.d}",
	"urls": [
		"https://www.pj64-emu.com/file/setup-project64-dev-{captures.a}-{captures.b}-{captures.c}-{captures.d}-{captures.hash}/"
	]
}
