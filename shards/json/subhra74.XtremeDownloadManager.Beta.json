{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "subhra74",
		"repo": "xdm",
		"method": "api-list",
		"kind": "all",
		"tagRegex": "-pre\\.\\d+$"
	},
	"urls": [
		"https://github.com/subhra74/xdm/releases/download/{github.rawTag}/xdm-{version}-x64.msi",
		"https://github.com/subhra74/xdm/releases/download/{github.rawTag}/xdm-{version}-arm64.msi"
	]
}
