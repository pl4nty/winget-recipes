{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.oo-software.com/en/oo-bluecon-disaster-recovery-for-companies",
		"regex": "\"softwareVersion\":\"(?<version>\\d+(?:\\.\\d+)+)\""
	},
	"urls": [
		"https://package.oo-software.com/winget/bluecon/{version}/oobluecon_{version}_eng_neutral.exe",
		"https://package.oo-software.com/winget/bluecon/{version}/oobluecon_{version}_deu_neutral.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.oo-software.com/en/support/productreleases"
	}
}
