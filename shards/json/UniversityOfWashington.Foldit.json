{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://fold.it/releases",
		"regex": "releases/(\\d+)\\?update_group=main"
	},
	"urls": [
		{ "url": "https://files.ipd.uw.edu/pub/foldit/Foldit-win_x86.exe", "architecture": "x86" },
		{ "url": "https://files.ipd.uw.edu/pub/foldit/Foldit-win_x64.exe", "architecture": "x64" }
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://fold.it/releases/{version}?update_group=main"
	}
}
