{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "OpenTabletDriver",
		"repo": "OpenTabletDriver"
	},
	"urls": [
		{
			"url": "https://github.com/OpenTabletDriver/OpenTabletDriver/releases/download/{github.rawTag}/OpenTabletDriver-{version}_win-x64.zip",
			"nestedInstallerMatches": ["OpenTabletDriver.UX.Wpf.exe"]
		}
	]
}
