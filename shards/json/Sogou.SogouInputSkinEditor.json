{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://pinyin.sogou.com/skins/design.php",
		"regex": "sogou_skineditor_(?<version>\\d+\\.\\d+)\\.(?<build>\\d+\\.\\d+)\\.exe"
	},
	"urls": [
		"https://ime.sogoucdn.com/sogou_skineditor_{version}.{captures.build}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://pinyin.sogou.com/skins/design.php"
	}
}
