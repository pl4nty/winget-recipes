{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "arduino",
		"repo": "arduino-ide",
		"method": "api-list",
		"kind": "all",
		"tagRegex": "^(?=\\d+\\.\\d+\\.\\d+-rc\\d)",
		"perPage": 100
	},
	"urls": [
		"https://downloads.arduino.cc/arduino-ide/arduino-ide_{version}_Windows_64bit.exe"
	]
}
