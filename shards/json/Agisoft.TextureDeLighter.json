{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.agisoft.com/downloads/installer/",
		"regex": "download\\.agisoft\\.com/delighter_(\\d+_\\d+_\\d+)_x64\\.msi"
	},
