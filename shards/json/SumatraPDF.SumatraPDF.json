{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.sumatrapdfreader.org/download-free-pdf-viewer",
		"regex": "dl/rel/(?<version>\\d+(?:\\.\\d+)+)/SumatraPDF-"
	},
	"urls": [
		"https://www.sumatrapdfreader.org/dl/rel/{version}/SumatraPDF-{version}-install.exe",
		"https://www.sumatrapdfreader.org/dl/rel/{version}/SumatraPDF-{version}.zip",
		"https://www.sumatrapdfreader.org/dl/rel/{version}/SumatraPDF-{version}-64-install.exe",
		"https://www.sumatrapdfreader.org/dl/rel/{version}/SumatraPDF-{version}-64.zip",
		"https://www.sumatrapdfreader.org/dl/rel/{version}/SumatraPDF-{version}-arm64-install.exe",
		"https://www.sumatrapdfreader.org/dl/rel/{version}/SumatraPDF-{version}-arm64.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.sumatrapdfreader.org/docs/Version-history"
	}
}
