{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://community.royalapps.com/t/royal-ts-v6-and-earlier-previous-versions/231.md",
		"regex": "RoyalTSInstaller_(?<version>(?<major>6)\\.0?(?<minor>\\d+)\\.(?<rest>\\d+\\.\\d+))\\.msi"
	},
	"version": "{captures.major}.{captures.minor}.{captures.rest}",
	"urls": [
		"https://download.royalapps.com/RoyalTS/RoyalTSInstaller_{version}.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://community.royalapps.com/t/royal-ts-v6-and-earlier-previous-versions/231"
	}
}
