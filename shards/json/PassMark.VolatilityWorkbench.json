{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.osforensics.com/tools/volatility-workbench.html",
		"regex": "V(?<major>\\d+\\.\\d+)\\s+build\\s+(?<build>\\d+)"
	},
	"version": "{captures.major}.{captures.build}",
	"urls": [
		"https://www.osforensics.com/downloads/VolatilityWorkbench.zip"
	],
	"state": {
		"source": "response-header",
		"url": "https://www.osforensics.com/downloads/VolatilityWorkbench.zip",
		"header": "etag"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://www.osforensics.com/tools/volatility-workbench.html"
	},
	"replace": true
}
