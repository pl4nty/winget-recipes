{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://updates.roonlabs.net/update/?v=2&platform=linuxx64&version=&product=RoonBridge&branding=roon&branch=production&curbranch=production",
		"regex": "displayversion=(?<major>\\d+\\.\\d+) \\(build (?<build>\\d+)\\) (?<branch>production)"
	},
	"version": "{captures.major} (build {captures.build}) {captures.branch}",
	"urls": [
		"https://download.roonlabs.net/builds/RoonBridgeInstaller64.exe",
		"https://download.roonlabs.net/builds/RoonBridgeInstaller.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://community.roonlabs.com/c/roon/software-release-notes/18"
	},
	"replace": true
}
