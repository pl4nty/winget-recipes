{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://helpx.adobe.com/adobe-connect/connect-downloads-updates.html",
		"regex": "Download for Windows[\\s\\S]*?>\\s*v(?<full>\\d{2}(?<version>\\d{2}\\.\\d+\\.\\d+))\\s*<"
	},
	"urls": ["https://download.adobe.com/pub/connect/updaters/meeting/11_0/ConnectApp11_{captures.full|.|_}.msi"],
	"releaseNotes": {
		"releaseNotesUrl": "https://helpx.adobe.com/adobe-connect/connect-downloads-updates.html"
	}
}
