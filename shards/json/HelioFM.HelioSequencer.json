{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://helio.fm/",
		"regex": "https://ci\\.helio\\.fm/helio\\-(\\d+(?:\\.\\d+)+)\\-x32\\.zip"
	},
	"urls": [
		{
			"url": "https://ci.helio.fm/helio-{version}-x32.zip",
			"architecture": "x86"
		},
		{
			"url": "https://ci.helio.fm/helio-{version}-x64.zip",
			"architecture": "x64"
		},
		{
			"url": "https://ci.helio.fm/helio-{version}.exe",
			"architecture": "neutral"
		}
	]
}
