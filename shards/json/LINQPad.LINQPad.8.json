{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.linqpad.net/Download.aspx",
		"regex": "lblLINQPad8Version\">(\\d+(?:\\.\\d+)+)<"
	},
	"urls": [
		{
			"url": "https://cdn.linqpad.net/public/LINQPad8Setup.exe",
			"architecture": "x64"
		},
		{
			"url": "https://cdn.linqpad.net/public/LINQPad8Setup.exe",
			"architecture": "x86"
		}
	]
}
