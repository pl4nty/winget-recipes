{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.cpuid.com/softwares/powermax.html",
		"regex": "powermax_(?<version>\\d+(?:\\.\\d+)+)\\.zip"
	},
	"urls": [
