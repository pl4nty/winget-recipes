{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.sublimemerge.com/updates/stable_update_check",
		"regex": "\"latest_version\":\\s*(?<version>\\d+)"
	},
	"urls": ["https://download.sublimetext.com/sublime_merge_build_{version}_x64.zip"],
	"releaseNotes": { "releaseNotesUrl": "https://www.sublimemerge.com/download" }
}
