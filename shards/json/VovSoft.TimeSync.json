{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/time-sync/",
		"regex": "<span class=\"notranslate\">Time Sync (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
