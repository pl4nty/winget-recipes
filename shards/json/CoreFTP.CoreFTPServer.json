{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.coreftp.com/server/",
		"regex": "Core FTP / SFTP Server v(?<major>\\d+) - Build (?<version>\\d+)"
	},
	"version": "{captures.major}.0.{version}",
	"urls": [
		{
			"url": "https://www.coreftp.com/server/download/CoreFTPServer.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.coreftp.com/server/download/CoreFTPServer64.exe",
			"architecture": "x64"
		}
	],
	"replace": true,
	"releaseNotes": {
		"releaseNotesUrl": "https://www.coreftp.com/forums/viewtopic.php?f=15&t=4022509"
	}
}
