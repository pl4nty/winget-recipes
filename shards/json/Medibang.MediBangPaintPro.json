{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://medibangpaint.com/en/pc/",
		"regex": "MediBangPaintProSetup-(\\d+\\.\\d+)-64bit\\.exe"
	},
	"version": "{version}.0.0",
	"urls": ["https://medibangpaint.com/static/installer/MediBangPaintPro/MediBangPaintProSetup-{version}-64bit.exe"]
}
