{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/http-requester/",
		"regex": "<span class=\"notranslate\">HTTP Requester (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": [
		{
			"url": "https://files.vovsoft.com/http-requester.exe",
			"architecture": "x64"
		},
		"https://files.vovsoft.com/http-requester-portable.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/http-requester/"
	}
}
