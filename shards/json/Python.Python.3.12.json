{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.python.org/downloads/windows/",
		"regex": "/ftp/python/3\\.12\\.\\d+/python-(?<version>3\\.12\\.\\d+)-amd64\\.exe\""
	},
	"urls": [
		{
			"url": "https://www.python.org/ftp/python/{version}/python-{version}.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.python.org/ftp/python/{version}/python-{version}-amd64.exe",
			"architecture": "x64"
		},
		{
			"url": "https://www.python.org/ftp/python/{version}/python-{version}-arm64.exe",
			"architecture": "arm64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://docs.python.org/release/{version}/whatsnew/changelog.html#python-{version|.|-}"
	}
}
