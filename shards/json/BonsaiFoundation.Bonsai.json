{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"version": {
		"source": "product"
	},
	"github": {
		"owner": "bonsai-rx",
		"repo": "bonsai"
	},
	"urls": [
		"https://github.com/bonsai-rx/bonsai/releases/download/{github.rawTag}/Bonsai-{github.version}.exe"
	],
	"state": {
		"source": "value",
		"value": "{github.rawTag}"
	}
}
