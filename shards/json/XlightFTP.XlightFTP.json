		},
		"https://www.xlightftpd.com/download/xlight-x64.zip",
		{
			"url": "https://www.xlightftpd.com/download/setup.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.xlightftpd.com/download/setup32.msi",
