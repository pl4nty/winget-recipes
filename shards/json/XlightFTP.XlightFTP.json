	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.xlightftpd.com/whatsnew.htm",
		"regex": "<strong>(?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{
			"url": "https://www.xlightftpd.com/download/xlight.zip",
