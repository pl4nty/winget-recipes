{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.jam-software.com/filelist/changes.shtml",
		"regex": "collapsed-item__ttl\">Version (\\d+(?:\\.\\d+)+)<"
	},
	"urls": [
		{
			"url": "https://downloads.jam-software.de/filelist/FileList.zip",
			"architecture": "x64",
			"nestedInstallerMatches": ["FileList.exe"]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.jam-software.com/filelist/changes.shtml"
	}
}
