{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": ["https://www.e2esoft.com/download/ivcam-x86", "https://www.e2esoft.com/download/ivcam-x64"],
		"regex": "/e2eSoft/products/releases/download/(?<tag>v[\\d.]+)/iVCam_x(?:86|64)_v(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
