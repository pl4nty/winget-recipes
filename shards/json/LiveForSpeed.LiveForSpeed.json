{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.lfs.net/downloads",
		"regex": "title=\"Latest Version : \\d+\\.(\\d+[A-Z])\""
	},
	"version": { "source": "file" },
	"urls": ["https://lfs-cdn.i3d.net/LFS_S3_{version}_setup.exe"],
	"state": { "source": "value", "value": "{version}" }
}
