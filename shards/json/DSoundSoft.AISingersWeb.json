	"strategy": "page-match",
	"pageMatch": {
		"url": "http://aisingers.com/ai/aiseditor/",
		"regex": "/img/soft/AISingers-Studio-Web_v(?<version>\\d+(?:\\.\\d+)+)(?<suffix>[^_\"']*)_(?<date>\\d{8})\\.zip"
	},
