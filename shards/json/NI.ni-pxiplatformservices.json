{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ni.com/en/support/downloads/drivers/download.pxi-platform-services.html",
		"regex": "/ni-pxiplatformservices/(?<short>\\d+\\.\\d+)/offline/ni-pxiplatformservices_(?<version>\\d+\\.\\d+\\.\\d+)_offline\\.iso(?![\\s\\S]*/ni-pxiplatformservices/\\d+\\.\\d+/offline/ni-pxiplatformservices_\\d)"
	},
	"urls": [
		{
			"url": "https://download.ni.com/support/nipkg/products/ni-p/ni-pxiplatformservices/{captures.short}/online/ni-pxiplatformservices_{captures.short}_online.exe",
			"architecture": "x64"
		}
	]
}
