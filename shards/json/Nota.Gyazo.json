{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://gyazo.com/download?lang=en",
		"regex": "files\\.gyazo\\.com/setup/Gyazo-(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		"https://files.gyazo.com/setup/Gyazo-{version}.exe"
	]
}
