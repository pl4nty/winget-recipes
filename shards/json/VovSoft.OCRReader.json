{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/ocr-reader/",
		"regex": "<span class=\"notranslate\">OCR Reader (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/ocr-reader.exe", "https://files.vovsoft.com/ocr-reader-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/ocr-reader/"
	}
}
