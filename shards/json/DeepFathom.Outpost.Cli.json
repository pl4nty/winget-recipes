{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://cdn.deepfathom.ai/outpost/public/stable/latest",
		"regex": "Outpost v(\\d+(?:\\.\\d+)+) \\(stable\\)"
	},
	"urls": [
		"https://cdn.deepfathom.ai/outpost/public/stable/v{version}/outpost-cli-win-x64-v{version}.zip",
		"https://cdn.deepfathom.ai/outpost/public/stable/v{version}/outpost-cli-win-arm64-v{version}.zip"
	]
}
