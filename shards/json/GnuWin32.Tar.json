{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/gnuwin32/rss?path=/tar",
		"regex": "/gnuwin32/files/tar/(?<version>\\d+(?:\\.\\d+)+(?:-\\d+)?)/tar-\\k<version>-bin\\.exe/download"
	},
	"urls": [
		"https://sourceforge.net/projects/gnuwin32/files/tar/{version}/tar-{version}-bin.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://gnuwin32.sourceforge.net/packages/tar.htm"
	}
}
