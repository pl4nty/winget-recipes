{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://www.wisecleaner.com/index.php?r=download-product/latest-version&product=wise-ad-cleaner"
		],
		"regex": "/soft/WADCleanerSetup_(?<version>\\d+\\.\\d+\\.\\d+)\\.(?<build>\\d+)\\.exe$"
	},
	"urls": [
		{
			"url": "https://downloads.wisecleaner.com/soft/WADCleanerSetup_{version}.{captures.build}.exe",
			"architecture": "x86"
		}
	]
}
