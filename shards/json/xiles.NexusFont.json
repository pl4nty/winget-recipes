{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.xiles.app/",
		"regex": "'(\\d+(?:\\.\\d+)+)':\\s*\\{\\s*'x64'"
	},
	"urls": [
		"https://s3.ap-northeast-2.amazonaws.com/net.xiles.public/download/nexusfont_setup_{version}.exe"
	]
}
