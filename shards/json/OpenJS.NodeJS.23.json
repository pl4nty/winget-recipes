{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://nodejs.org/dist/",
		"regex": "href=\"v(23\\.\\d+\\.\\d+)/\""
	},
	"urls": [
		"https://nodejs.org/dist/v{version}/node-v{version}-x64.msi",
		"https://nodejs.org/dist/v{version}/node-v{version}-arm64.msi",
		"https://nodejs.org/dist/v{version}/node-v{version}-win-x64.zip",
		"https://nodejs.org/dist/v{version}/node-v{version}-win-arm64.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://nodejs.org/en/blog/release/v{version}"
	}
}
