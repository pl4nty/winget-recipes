{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/proxy-checker/",
		"regex": "<span class=\"notranslate\">Proxy Checker (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/proxy-checker.exe", "https://files.vovsoft.com/proxy-checker-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/proxy-checker/"
	}
}
