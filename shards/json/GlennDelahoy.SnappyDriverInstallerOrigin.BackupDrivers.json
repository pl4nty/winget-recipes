{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.glenn.delahoy.com/snappy-driver-installer-origin/",
		"regex": "href=\"/downloads/sdio/(?<file>SDIOBackupDrivers\\d+\\.zip)\"[^>]*>SDIO Backup Drivers v(?<version>\\d+(?:\\.\\d+)+)<"
	},
	"urls": [
		{
			"url": "https://www.glenn.delahoy.com/downloads/sdio/{captures.file}",
			"architecture": "x64",
			"nestedInstallerMatches": ["SDIOBackupDrivers.exe"]
		},
		{
			"url": "https://www.glenn.delahoy.com/downloads/sdio/{captures.file}",
			"architecture": "x86",
			"nestedInstallerMatches": ["SDIOBackupDrivers-32.exe"]
		}
	]
}
