{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.foldersizes.com/download",
		"regex": "softwareVersion\">(?<full>(?<version>(?<major>\\d+)\\.\\d+\\.\\d+)\\.\\d+)<"
	},
	"urls": [
		"https://www.foldersizes.com/content/download/{captures.full}/fs{captures.major}-setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.foldersizes.com/content/static/releasenotes.htm"
	}
}
