{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://x-diesel.com/",
		"regex": "<B>Unreal Commander v(?<major>\\d+)\\.(?<minor>\\d)(?<patch>\\d) beta \\d+ \\(build (?<version>\\d+)\\)</B>"
	},
	"version": "{captures.major}.{captures.minor}.{captures.patch}.{version}",
	"urls": ["https://x-diesel.com/download/uncomsetup.exe", "https://x-diesel.com/download/uncomsetup.msi"],
	"replace": true
}
