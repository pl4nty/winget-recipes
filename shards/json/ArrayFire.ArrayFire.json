{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://arrayfire.com/binaries/",
		"regex": "arrayfire\\.gateway\\.scarf\\.sh/windows/(?<version>\\d+(?:\\.\\d+)+)/(?<cuda>\\d+(?:\\.\\d+)+)/ArrayFire\\.exe"
	},
	"urls": [
		"https://arrayfire.s3.amazonaws.com/{version}/ArrayFire-v{version}-CUDA-{captures.cuda}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/arrayfire/arrayfire/releases/tag/v{version}"
	}
}
