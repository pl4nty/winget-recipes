{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://the-sz.com/products/banks/",
		"regex": "Product: 'banks', Link[^>]*title=\"Version (\\d+(?:\\.\\d+)+) &middot;"
	},
	"urls": [
		"https://the-sz.com/products/banks/history/{version}/Banks.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://the-sz.com/common/history.php?product=banks"
	},
	"cleanup": false
}
