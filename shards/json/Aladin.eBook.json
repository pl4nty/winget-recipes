{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.aladin.co.kr/events/wevent.aspx?EventId=212360",
		"regex": "https://softcdn\\.ebook\\.aladin\\.co\\.kr/viewer/(?<version>\\d+(?:\\.\\d+)+)/setup\\.exe"
	},
	"urls": [
		{
			"url": "https://softcdn.ebook.aladin.co.kr/viewer/{version}/setup.exe",
			"architecture": "x86"
		},
		{
			"url": "https://softcdn.ebook.aladin.co.kr/viewer/{version}/setup.exe",
			"architecture": "x64"
		}
	]
}
