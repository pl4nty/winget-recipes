{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://dl.jami.net/windows/beta/version",
		"regex": "(?<build>\\d{12})"
	},
	"version": { "source": "display" },
	"state": { "source": "value", "value": "{captures.build}" },
	"urls": ["https://dl.jami.net/windows/beta/archive/jami_x86_64_beta-{captures.build}.msi"]
}
