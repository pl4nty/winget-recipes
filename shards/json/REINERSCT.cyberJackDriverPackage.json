{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.reiner-sct.com/treiber-windows",
		"regex": "Treiber-Download Version (\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{ "url": "https://dp.reiner-sct.com/downloads/dp/dp_{version|.|_}.exe", "architecture": "x64" },
		{ "url": "https://dp.reiner-sct.com/downloads/dp/dp_{version|.|_}.exe", "architecture": "arm64" }
	]
}
