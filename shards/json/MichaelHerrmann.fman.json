{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://fman.io/changelog",
		"regex": "id=\"v(\\d+(?:\\.\\d+)+)\""
	},
	"urls": [
		"https://download.fman.io/{version}/fmanSetup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://fman.io/changelog#v{version}"
	}
}
