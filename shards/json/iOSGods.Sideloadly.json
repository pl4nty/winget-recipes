{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sideloadly.io/",
		"regex": ">v(\\d+(?:\\.\\d+)+) &middot; macOS [^<]*Windows"
	},
	"urls": [
