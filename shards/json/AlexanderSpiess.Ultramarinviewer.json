{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ultramarinviewer.de/",
		"regex": "/assets/Ultramarinviewer-(\\d+(?:-\\d+)+)\\.msi"
	},
	"version": "{version|-|.}",
	"urls": [
		"https://www.ultramarinviewer.de/assets/Ultramarinviewer-{version}.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ultramarinviewer.de/"
	}
}
