{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://z.weixin.qq.com/",
		"regex": "\"latest\":\"https://download\\.z\\.weixin\\.qq\\.com/app/win/WeTypeSetup_(?<version>\\d+(?:\\.\\d+)+)\\.exe\""
	},
	"urls": [
		{
			"url": "https://download.z.weixin.qq.com/app/win/WeTypeSetup_{version}.exe",
			"architecture": "x64"
		},
		{
			"url": "https://download.z.weixin.qq.com/app/win/WeTypeSetup_{version}.exe",
			"architecture": "arm64"
		}
	]
}
