{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.satsignal.eu/software/wxtrack.htm",
		"regex": "wxtrack\\.(\\d+\\.\\d+\\.\\d+)\\.zip"
	},
	"version": {
		"source": "file"
	},
	"state": {
		"source": "value",
		"value": "{version}"
	},
	"urls": [
		"https://www.satsignal.eu/software/wxtrack.{version}.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.satsignal.eu/software/wxtrack.htm"
	}
}
