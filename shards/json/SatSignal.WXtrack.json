{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.satsignal.eu/software/wxtrack.htm",
		"regex": "href=\"wxtrack\\.(?<file>\\d+(?:\\.\\d+)+)\\.zip\""
	},
	"version": {
		"source": "file"
	},
	"urls": [
		{
			"url": "https://www.satsignal.eu/software/wxtrack.{captures.file}.zip",
			"architecture": "x86"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.satsignal.eu/software/wxtrack.htm"
	}
}
