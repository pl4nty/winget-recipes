{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://quickgamma.de/indexen.html",
		"regex": "QuickGammaV(?<a>\\d)(?<b>\\d)(?<c>\\d)(?<d>\\d)EN\\.exe"
	},
	"version": "{captures.a}.{captures.b}.{captures.c}.{captures.d}",
	"urls": [
		"https://quickgamma.de/QuickGammaV{captures.a}{captures.b}{captures.c}{captures.d}EN.exe"
	]
}
