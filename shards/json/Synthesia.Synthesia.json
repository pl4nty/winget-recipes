{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": ["https://synthesiagame.com/get?platform=win"],
		"regex": "/Synthesia-(\\d+(?:\\.\\d+)+)-installer\\.exe$"
	},
	"version": {
		"source": "product"
	},
	"state": {
		"source": "value",
		"value": "{version}"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://synthesiagame.com/releases"
	}
}
