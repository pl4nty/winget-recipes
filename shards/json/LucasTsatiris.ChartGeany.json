{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/chart-geany/rss?path=/",
		"regex": "<title><!\\[CDATA\\[/(?<dir>[^\\]]+)/chartgeany-(?<version>\\d+(?:\\.\\d+)+)-setup-win10\\.exe"
	},
	"urls": [
		"https://sourceforge.net/projects/chart-geany/files/{captures.dir}/chartgeany-{version}-setup-win10.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://sourceforge.net/projects/chart-geany/files/{captures.dir}/"
	}
}
