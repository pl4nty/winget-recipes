{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.atnsoft.com/textpaster/versions/",
		"regex": "<h3>(\\d+\\.\\d+) build (?<build>\\d+)<em>"
	},
	"version": "{version}.0.{captures.build}",
	"urls": [
		"https://atnsoft.com/downloads/textpaster_setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.atnsoft.com/textpaster/versions/"
	}
}
