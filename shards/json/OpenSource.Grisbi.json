{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/grisbi/rss?path=/grisbi%20stable",
		"regex": "/grisbi stable/(?<series>[^/\\]]+)/(?<version>\\d+(?:\\.\\d+)+)/Grisbi-64bit-\\d+(?:\\.\\d+)+-setup\\.exe"
	},
	"urls": [
		"https://sourceforge.net/projects/grisbi/files/grisbi%20stable/{captures.series}/{version}/Grisbi-64bit-{version}-setup.exe/download"
	]
}
