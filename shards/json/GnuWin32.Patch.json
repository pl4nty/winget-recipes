{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/gnuwin32/rss?path=/patch",
		"regex": "/files/patch/(\\d+(?:[.-]\\d+)+)/patch-\\1-bin\\.zip/download"
	},
	"urls": [
		"https://sourceforge.net/projects/gnuwin32/files/patch/{version}/patch-{version}-bin.zip/download"
	]
}
