{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://whonet.org/WHONET-ReleaseNotes.html",
		"regex": "Version\\s+(?<version>\\d+(?:\\.\\d+)+)\\s*</button>[\\s\\S]*?<div class=\"accordion-body\">\\s*<ul>[\\s\\S]*?</ul>[\\s\\S]*?href=\"/releases/(?<file>WHONET\\d{4}-Setup)-x64-v\\k<version>\\.exe\""
	},
	"urls": [
		{
			"url": "https://whonet.org/releases/{captures.file}-x86-v{version}.exe",
			"architecture": "x86"
		},
		{
			"url": "https://whonet.org/releases/{captures.file}-x64-v{version}.exe",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://whonet.org/WHONET-ReleaseNotes.html"
	}
}
