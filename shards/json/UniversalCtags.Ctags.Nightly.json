{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"version": "{version|-|.}",
	"github": {
		"owner": "universal-ctags",
		"repo": "ctags-win32",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "(?<=^\\d{4}-\\d{2}-\\d{2})/.*$"
	},
	"urls": [
		"https://github.com/universal-ctags/ctags-win32/releases/download/{github.rawTag}/ctags-{github.rawTag|/|_}-x64.zip",
		"https://github.com/universal-ctags/ctags-win32/releases/download/{github.rawTag}/ctags-{github.rawTag|/|_}-x86.zip"
	]
}
