{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.log4om.com/download/",
		"regex": "Log4OM2_(?<version>\\d+(?:_\\d+){3})\\.zip"
	},
	"version": "{version|_|.}",
	"urls": [
		{
			"url": "https://www.log4om.com/l4ong/release/Log4OM2_{captures.version}.zip",
			"nestedInstallerMatches": ["Log4OM2_"]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.log4om.com/download/"
	}
}
