{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://en.akkogear.com/download/",
		"regex": "file\\.akkogear\\.com/Akko_Cloud_setup_(?<version>\\d+(?:\\.\\d+)+)\\((?<build>WIN\\d+)\\)\\.zip"
	},
	"urls": [
		{
			"url": "https://file.akkogear.com/Akko_Cloud_setup_{version}({captures.build}).zip",
			"nestedInstallerMatches": [
				"Akko_Cloud_setup_"
			]
		}
	]
}
