{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.diskboss.com/downloads.html",
		"regex": "setups/diskbosssrv_setup_v(\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		{
			"url": "https://www.diskboss.com/setups/diskbosssrv_setup_v{version}.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.diskboss.com/setups_x64/diskbosssrv_setup_v{version}_x64.exe",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.diskboss.com/news.html"
	}
}
