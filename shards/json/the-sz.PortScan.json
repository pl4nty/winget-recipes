{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://the-sz.com/products/portscan/",
		"regex": "title=\"Version (\\d+\\.\\d+) &middot;"
	},
	"urls": [
		{
			"url": "https://the-sz.com/products/portscan/history/{version}/PortScan.zip",
			"nestedInstallerMatches": [
				"PortScan.exe"
			]
		}
	]
}
