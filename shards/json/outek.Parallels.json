{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://download.parallels.com/ras/RASClient.xml",
		"regex": "download\\.parallels\\.com/ras/(?<dir>v\\d+/\\d+(?:\\.\\d+)+)/RASClient_Basic-x64-(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		"https://download.parallels.com/ras/{captures.dir}/RASClient_Basic-x64-{version}.zip",
		"https://download.parallels.com/ras/{captures.dir}/RASClient_Basic-{version}.zip",
		"https://download.parallels.com/ras/{captures.dir}/RASClient_Basic-ARM64-{version}.zip"
	]
}
