{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.pinpointaprs.com/download.html",
		"regex": "Latest Stable Version</h2>[\\s\\S]*?href=\"Pinpoint_v(\\d+\\.\\d+)_build_(?<build>\\d+)\\.msi\""
	},
	"version": "{version}-{captures.build}",
	"urls": [
		"https://www.pinpointaprs.com/Pinpoint_v{version}_build_{captures.build}.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.pinpointaprs.com/download.html"
	}
}
