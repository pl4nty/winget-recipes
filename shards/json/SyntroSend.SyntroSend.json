{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": ["https://download.syntrosend.workers.dev/windows"],
		"regex": "/releases/download/v(?<version>\\d+(?:\\.\\d+)+)/SyntroSend_\\k<version>_x64-setup\\.exe"
	},
	"releaseNotes": { "source": "github", "owner": "syntrosend", "repo": "syntrosend-app", "tag": "v{version}", "cleanup": false }
}
