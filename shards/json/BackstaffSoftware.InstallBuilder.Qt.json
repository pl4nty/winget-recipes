{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://installbuilder.com/download-step-2.html",
		"regex": "installbuilder-(?<version>\\d+(?:\\.\\d+)+)-windows-installer\\.exe"
	},
	"urls": [
		{
			"url": "https://releases.installbuilder.com/installbuilder/installbuilder-qt-{version}-windows-installer.exe",
			"architecture": "x86"
		},
		{
			"url": "https://releases.installbuilder.com/installbuilder/installbuilder-qt-{version}-windows-x64-installer.exe",
			"architecture": "x64"
		}
	]
}
