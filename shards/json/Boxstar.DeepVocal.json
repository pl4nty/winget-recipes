{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "json",
	"json": {
		"url": "https://api.deep-vocal.com/api/editor/version",
		"path": "version"
	},
	"urls": [
		{
			"url": "https://dl.deep-vocal.com/editor/Setup_DeepVocal_{version}.zip",
			"nestedInstallerMatches": [
				"Setup_DeepVocal_{version}.exe"
			]
		}
	],
	"cleanup": false
}
