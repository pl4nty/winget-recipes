{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/desktop-diary/",
		"regex": "<span class=\"notranslate\">Desktop Diary (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/desktop-diary.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/desktop-diary/"
	}
}
