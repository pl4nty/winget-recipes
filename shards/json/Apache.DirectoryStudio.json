{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://dlcdn.apache.org/directory/studio/",
		"regex": "href=\"(?<version>(?<base>\\d+(?:\\.\\d+)+)\\.v\\d+-(?<milestone>M\\d+))/\""
	},
	"version": "{captures.base}-{captures.milestone}",
	"urls": [
		"https://dlcdn.apache.org/directory/studio/{captures.version}/ApacheDirectoryStudio-{captures.version}-win32.win32.x86_64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://directory.apache.org/studio/news.html"
	}
}
