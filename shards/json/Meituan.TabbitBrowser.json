{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.tabbit.ai/api/v0/upgrade/latest?from=website",
		"regex": "\"version\":\"(?<version>(?<short>\\d+\\.\\d+\\.\\d+)\\.\\d+)\",\"sparkle_version\":\\d+,\"download_url\":\"[^\"]*\",\"file_length\":\\d+,\"platform\":\"windows\""
	},
	"urls": ["https://releases.tabbit.ai/upgrade/windows/stable_x64_intl/Tabbit_stable_x64_intl_{captures.short}.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.tabbit.ai/docs/en-US/whats-new"
	}
}
