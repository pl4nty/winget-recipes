{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.fujifilm.com/fb/ja/support/software/document-management/docuworks/download/101",
		"regex": "https://asset-fb\\.fujifilm\\.com/www/fb/files/(?<path>\\d{4}-\\d{2}/[0-9a-f]{32})/(?<file>dwvlt(?<version>\\d+(?:_\\d+)+)\\.zip)"
	},
	"version": "{version|_|.}",
	"urls": [
		"https://asset-fb.fujifilm.com/www/fb/files/{captures.path}/{captures.file}"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.fujifilm.com/fb/ja/support/software/document-management/docuworks/download/101"
	}
}
