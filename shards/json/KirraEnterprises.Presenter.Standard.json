{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://presenter.software/download/",
		"regex": "/dl/Presenter_Standard_Setup_(?<version>\\d+(?:-\\d+)+)\\.exe"
	},
