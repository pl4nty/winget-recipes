{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://support.zortrax.com/downloads/software/",
		"regex": "wp-content/uploads/(?<path>\\d{4}/\\d{2})/(?<file>Z-SUITE_v(?<version>\\d+(?:\\.\\d+)+)_Win\\.exe_?\\.zip)"
	},
	"urls": [
		{
			"url": "https://support.zortrax.com/wp-content/uploads/{captures.path}/{captures.file}",
			"nestedInstallerMatches": ["Z-SUITE_v{version}_Win.exe"]
		},
		{
			"url": "https://support.zortrax.com/wp-content/uploads/{captures.path}/{captures.file}",
			"nestedInstallerMatches": ["Z-SUITE_v{version}_Win.exe"]
		}
	]
}
