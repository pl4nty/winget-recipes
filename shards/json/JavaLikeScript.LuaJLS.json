{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "javalikescript",
		"repo": "luajls",
		"method": "api-sort",
		"assetRegex": "^(?:luajls\\-\\d+\\.\\d+\\-x86_64\\-windows\\.\\d+\\.zip)$"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/javalikescript/luajls/releases/tag/{github.rawTag}"
	}
}
