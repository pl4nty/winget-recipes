{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.winuae.net/download/",
		"regex": "<a href=\"https://www\\.winuae\\.net/(?<notes>\\d{4}/\\d{2}/\\d{2}/winuae-[\\d-]+/)\">WinUAE (?<version>\\d+\\.\\d+\\.\\d+)</a>"
	},
	"urls": [
		"https://download.abime.net/winuae/releases/InstallWinUAE{version|.|}0.msi",
		"https://download.abime.net/winuae/releases/InstallWinUAE{version|.|}0_x64.msi"
