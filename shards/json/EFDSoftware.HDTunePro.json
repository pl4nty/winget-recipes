{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.hdtune.com/download.html",
		"regex": "files/(?<name>[Hh][Dd][Tt]une[Pp]ro)_(?<version>(?<major>\\d)(?<minor>\\d{2}))_trial\\.exe"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		"https://www.hdtune.com/files/{captures.name}_{captures.major}{captures.minor}_trial.exe"
	]
}
