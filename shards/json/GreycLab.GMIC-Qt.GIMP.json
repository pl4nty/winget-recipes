{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://gmic.eu/download.html",
		"regex": "file=windows/gmic_(?<version>\\d+(?:\\.\\d+)+)_gimp(?<gimp>\\d+(?:\\.\\d+)*)_win64\\.exe"
	},
	"urls": [
		"https://gmic.eu/get_file.php?file=windows/gmic_{version}_gimp{captures.gimp}_win64.exe"
	]
}
