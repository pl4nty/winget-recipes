{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/link-analyzer/",
		"regex": "<span class=\"notranslate\">Link Analyzer (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/link-analyzer.exe", "https://files.vovsoft.com/link-analyzer-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/link-analyzer/"
	}
}
