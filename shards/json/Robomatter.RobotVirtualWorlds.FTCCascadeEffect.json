{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.robotvirtualworlds.com/",
		"regex": "files/competition-worlds/RVWLevelPack_FTCCascadeEffect(?<version>(?<major>\\d)(?<minor>\\d)(?<patch>\\d+))\\.exe"
	},
