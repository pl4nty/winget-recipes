{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://shurufa.sogou.com/",
		"regex": "\\\\?\"normal\\\\?\":\\\\?\"(?<url>https?://ime\\.gtimg\\.com/pc/sogou_pinyin_[\\d.]+\\.exe)\\\\?\",\\\\?\"name\\\\?\":\\\\?\"windows\\\\?\""
	},
	"version": {
		"source": "product"
	},
	"urls": [
		"{captures.url|http:|https:}"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://pinyin.sogou.com/changelog.php"
	},
	"state": {
		"source": "response-header",
		"url": "{captures.url|http:|https:}",
		"header": "etag"
	}
}
