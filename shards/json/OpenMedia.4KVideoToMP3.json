{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.4kdownload.com/products/videotomp3",
		"regex": "\"softwareVersion\":\"(?<version>(?<short>\\d+\\.\\d+\\.\\d+)\\.\\d+)\""
	},
	"urls": [
		"https://dl.4kdownload.com/app/4kvideotomp3_{captures.short}.msi",
		"https://dl.4kdownload.com/app/4kvideotomp3_{captures.short}_online.exe",
		"https://dl.4kdownload.com/app/4kvideotomp3_{captures.short}_x64.msi",
		"https://dl.4kdownload.com/app/4kvideotomp3_{captures.short}_x64_online.exe"
	]
}
