{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "pnpm",
		"repo": "pnpm",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "^v(?=\\d)"
	},
	"urls": [
		"https://github.com/pnpm/pnpm/releases/download/{github.rawTag}/pnpm-win32-x64.zip"
	]
}
