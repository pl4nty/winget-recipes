{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-commit",
	"github": {
		"owner": "RickStrahl",
		"repo": "DocumentationMonster",
		"branch": "main",
		"path": "Releases/DocumentationMonsterSetup.exe"
	},
	"version": {
		"source": "product"
	},
	"urls": [
		{
			"url": "https://raw.githubusercontent.com/RickStrahl/DocumentationMonster/{github.commit}/Releases/DocumentationMonsterSetup.exe",
			"architecture": "neutral"
		}
	],
	"state": {
		"source": "value",
		"value": "{github.commit}"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/RickStrahl/DocumentationMonster/blob/main/Changelog.md"
	}
}
