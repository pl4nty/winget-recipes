{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/vov-screen-recorder/",
		"regex": "<span class=\"notranslate\">Vov Screen Recorder (?<version>\\d+\\.\\d+)</span>"
	},
