{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/photos-to-video/",
		"regex": "<span class=\"notranslate\">Photos to Video (?<version>\\d+\\.\\d+)</span>"
	},
