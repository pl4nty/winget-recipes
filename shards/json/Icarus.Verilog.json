{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://bleyer.org/icarus/",
		"regex": "iverilog-v(?<major>\\d+)-(?<y>\\d{4})(?<m>\\d{2})(?<d>\\d{2})-x64_setup\\.exe"
	},
	"version": "{captures.major}.{captures.y}.{captures.m}.{captures.d}",
	"urls": [
		{
			"url": "https://bleyer.org/icarus/iverilog-v{captures.major}-{captures.y}{captures.m}{captures.d}-x64_setup.exe",
			"architecture": "x64"
		}
	]
}
