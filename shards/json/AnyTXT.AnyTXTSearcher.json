{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://sourceforge.net/projects/anytxt/rss?limit=100",
		"regex": "/Anytxt_(\\d+(?:\\.\\d+)+)_Windows_X86_64\\.exe"
	},
	"urls": [
