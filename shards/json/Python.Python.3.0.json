{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.python.org/downloads/windows/",
		"regex": "ftp/python/(3\\.0\\.\\d+)/python-3\\.0\\.\\d+\\.amd64\\.msi"
	},
	"urls": [
		{
			"url": "https://www.python.org/ftp/python/{version}/python-{version}.msi",
			"architecture": "x86"
		},
		{
			"url": "https://www.python.org/ftp/python/{version}/python-{version}.amd64.msi",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.python.org/downloads/release/python-{version|.|}/"
	}
}
