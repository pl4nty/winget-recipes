{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/syslog-server/",
		"regex": "<span class=\"notranslate\">Syslog Server (?<version>\\d+\\.\\d+)</span>"
	},
