{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://dragon-lang.org/downloads",
		"regex": "/Dragon_v(\\d+(?:\\.\\d+)+)_Windows_x86_64\\.zip"
	},
	"urls": [
		{
			"url": "https://dragon-lang.org/Dragon_v{version}_Windows_x86_64.zip",
			"architecture": "x64"
		},
		{
			"url": "https://dragon-lang.org/Dragon_v{version}_Windows_aarch64.zip",
			"architecture": "arm64"
		}
	]
}
