{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": ["https://packages.cloudfoundry.org/stable?release=windows64&version=v8&source=github"],
		"regex": "/cf8-cli-installer_(\\d+(?:\\.\\d+)+)_winx64\\.zip$"
	},
	"urls": [
		"https://s3-us-west-1.amazonaws.com/v8-cf-cli-releases/releases/v{version}/cf8-cli_{version}_winx64.zip",
		"https://s3-us-west-1.amazonaws.com/v8-cf-cli-releases/releases/v{version}/cf8-cli_{version}_win32.zip",
		"https://s3-us-west-1.amazonaws.com/v8-cf-cli-releases/releases/v{version}/cf8-cli-installer_{version}_winx64.zip",
		"https://s3-us-west-1.amazonaws.com/v8-cf-cli-releases/releases/v{version}/cf8-cli-installer_{version}_win32.zip"
	]
}
