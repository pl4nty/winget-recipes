{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.femm.info/doku/doku.php?id=Download",
		"regex": "media=upload:(?<dir>[a-z]+):femm(?<version>(?<major>\\d)(?<minor>\\d))bin_x64_(?<date>\\d+[a-z]+\\d+)\\.exe"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		{
			"url": "https://www.femm.info/doku/lib/exe/fetch.php?media=upload:{captures.dir}:femm{captures.major}{captures.minor}bin_win32_{captures.date}.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.femm.info/doku/lib/exe/fetch.php?media=upload:{captures.dir}:femm{captures.major}{captures.minor}bin_x64_{captures.date}.exe",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.femm.info/wiki/ReadMe42"
	}
}
