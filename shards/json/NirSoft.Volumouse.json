{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.nirsoft.net/utils/volumouse.html",
		"regex": "Versions History</h4>\\s*<ul>\\s*<li>Version (?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		"https://www.nirsoft.net/utils/volumouse_setup.exe",
		{ "url": "https://www.nirsoft.net/utils/volumouse.zip", "architecture": "x86" },
		"https://www.nirsoft.net/utils/volumouse-x64.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.nirsoft.net/utils/volumouse.html#:~:text=Versions%20History"
	},
	"replace": true
}
