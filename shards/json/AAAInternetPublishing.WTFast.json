{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://download.wtfast.com/product/wtfast/index.html"
		],
		"regex": "wtfastsetup\\.(\\d+(?:\\.\\d+)+)\\.exe$"
	},
	"version": "{version}.0",
	"urls": [
		"https://download.wtfast.com/product/wtfast/wtfastsetup.{version}.exe"
	]
}
