	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://repository.drovio.com/",
		"regex": "/stable/drovio/win64/3\\.x/(\\d+(?:\\.\\d+)+)/drovio\\-win64\\.exe"
	},
