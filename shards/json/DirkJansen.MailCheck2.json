{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.d-jan.de/download.shtml",
		"regex": "Aktuelle Version:<br><b>(?<version>\\d+\\.\\d+)</b>[\\s\\S]{0,5000}?href=\"MailCheck2Setup(?<file>\\d+)Build(?<build>\\d+)-64bit\\.exe\""
	},
	"version": "{version} (Build {captures.build})",
	"urls": [
		"https://www.d-jan.de/MailCheck2Setup{captures.file}Build{captures.build}-64bit.exe",
		"https://www.d-jan.de/MailCheck2Setup{captures.file}Build{captures.build}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.d-jan.de/historie.shtml"
	}
}
