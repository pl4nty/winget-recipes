{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/vcf-editor/",
		"regex": "<span class=\"notranslate\">VCF Editor (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/vcf-editor.exe", "https://files.vovsoft.com/vcf-editor-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/vcf-editor/"
	}
}
