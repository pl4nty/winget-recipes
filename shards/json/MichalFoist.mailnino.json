{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://mailnino.cz/en/",
		"regex": "mailnino_(\\d+(?:\\.\\d+)+)_x64-setup\\.exe"
	},
	"urls": ["https://mailnino.cz/mailnino_{version}_x64-setup.exe", "https://mailnino.cz/mailnino_{version}_x64.msi"],
	"releaseNotes": {
		"releaseNotesUrl": "https://mailnino.cz/en/novinky/"
	}
}
