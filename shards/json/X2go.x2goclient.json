		"regex": "href=\"(\\d+(?:\\.\\d+)+-\\d{4}\\.\\d{2}\\.\\d{2})/\"(?![\\s\\S]*href=\"\\d+(?:\\.\\d+)+-\\d{4}\\.\\d{2}\\.\\d{2}/\")"
	},
