{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.mitec.cz/wp/xml/vh_smbe.xml",
		"regex": "<VERSION>(\\d+(?:\\.\\d+)+)</VERSION>"
	},
	"urls": [
		{
			"url": "https://www.mitec.cz/wp/files/SMBE.zip",
			"architecture": "x86",
			"nestedInstallerMatches": [
				"SMBE.exe"
			]
		},
		{
			"url": "https://www.mitec.cz/wp/files/SMBE.zip",
			"architecture": "x64",
			"nestedInstallerMatches": [
				"SMBE64.exe"
			]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.mitec.cz/wp/xml/vh_smbe.xml"
	}
}
