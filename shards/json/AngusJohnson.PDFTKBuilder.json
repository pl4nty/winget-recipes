{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.angusj.com/pdftkb/",
		"regex": "Version (?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		"https://www.angusj.com/pdftkb/pdftkb_setup.exe"
	],
	"replace": true,
	"releaseNotes": {
		"releaseNotesUrl": "https://www.angusj.com/pdftkb/"
	}
}
