{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ssesetup.com/download.html",
		"regex": "EZSignIt(?<version>(?<major>\\d+)(?<minor>\\d))\\.exe"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		{
			"url": "https://www.ssesetup.com/downloads/EZSignIt{captures.version}.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.ssesetup.com/downloads/EZSignIt{captures.version}noinstall.zip",
			"architecture": "x86"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ssesetup.com/download.html"
	}
}
