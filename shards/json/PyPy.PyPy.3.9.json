{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://downloads.python.org/pypy/",
		"regex": "href=\"pypy3\\.9-v(\\d+\\.\\d+\\.\\d+)-win64\\.zip\""
	},
	"urls": [
		"https://downloads.python.org/pypy/pypy3.9-v{version}-win64.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://doc.pypy.org/en/latest/release-v{version}.html"
	}
}
