{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/customer-tracker/",
		"regex": "<span class=\"notranslate\">Customer Tracker (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/customer-tracker.exe", "https://files.vovsoft.com/customer-tracker-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/customer-tracker/"
	}
}
