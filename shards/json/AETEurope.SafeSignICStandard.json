{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://safesign.gdamericadosul.com.br/Windows",
		"regex": "href=\"content/windows_x64_(\\d+(?:\\.\\d+)+)_aet\\.zip\" download>\\s*<div class=\"file-image\"></div>\\s*<div class=\"version\">Vers\\S+ [\\d.]+</div>"
	},
	"urls": [
		{
			"url": "https://safesign.gdamericadosul.com.br/content/windows_x64_{version}_aet.zip",
			"nestedInstallerMatches": ["SafeSign IC Standard"]
		},
		{
			"url": "https://safesign.gdamericadosul.com.br/content/windows_x86_{version}_aet.zip",
			"nestedInstallerMatches": ["SafeSign IC Standard"]
		}
	]
}
