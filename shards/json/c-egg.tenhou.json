{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://tenhou.net/1/tenhou-win.msi"
		],
		"regex": "/tenhou-win(?<major>\\d)(?<minor>\\d)(?<patch>\\d)\\.msi$"
	},
	"version": "{version}.{captures.minor}.{captures.patch}.0"
}
