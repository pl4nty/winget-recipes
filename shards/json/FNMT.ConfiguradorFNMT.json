	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.sede.fnmt.gob.es/descargas/descarga-software",
		"regex": "https://descargas\\.cert\\.fnmt\\.es/Windows/Configurador_FNMT_(\\d+(?:\\.\\d+)+)_64bits\\.exe"
	},
