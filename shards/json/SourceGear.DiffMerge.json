{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourcegear.com/diffmerge/downloads.html",
		"regex": "/DiffMerge/(?<dir>\\d+(?:\\.\\d+)+)/DiffMerge_(?<version>\\d+(?:\\.\\d+)+)\\.stable_x64\\.msi"
	},
	"urls": [
		"https://download.sourcegear.com/DiffMerge/{captures.dir}/DiffMerge_{version}.stable_x64.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://sourcegear.com/diffmerge/webhelp/chapter_release_notes.html"
	}
}
