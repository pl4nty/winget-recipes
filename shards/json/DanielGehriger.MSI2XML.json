{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/msi2xml/rss",
		"regex": "/files/msi2xml/(?<dir>\\d+(?:\\.\\d+)+)/msi2xml-(?<version>\\d+(?:\\.\\d+)+)\\.msi/download"
	},
	"urls": [
		"https://sourceforge.net/projects/msi2xml/files/msi2xml/{captures.dir}/msi2xml-{version}.msi/download"
	]
}
