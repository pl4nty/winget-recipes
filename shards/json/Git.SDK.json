{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "git-for-windows",
		"repo": "build-extra",
		"tagRegex": "^git-sdk-"
	},
	"urls": [
		{
			"url": "https://github.com/git-for-windows/build-extra/releases/download/{github.rawTag}/git-sdk-installer-{version}-32.7z.exe",
			"architecture": "x86"
		},
		{
			"url": "https://github.com/git-for-windows/build-extra/releases/download/{github.rawTag}/git-sdk-installer-{version}-64.7z.exe",
			"architecture": "x64"
		}
	]
}
