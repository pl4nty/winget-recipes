{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.intel.com/content/www/us/en/download/12136/intel-processor-identification-utility-windows-version.html",
		"regex": "downloadmirror\\.intel\\.com/(?<id>\\d+)/Intel_Processor_Identification_Utility_v(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		"https://downloadmirror.intel.com/{captures.id}/Intel_Processor_Identification_Utility_v{version}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://downloadmirror.intel.com/{captures.id}/release_notes_v{version}.html"
	}
}
