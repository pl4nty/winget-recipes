{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.progdvb.com/prog_sat_finder.html",
		"regex": "ProgFinderSetup(\\d+(?:\\.\\d+)+)x64\\.exe"
	},
	"urls": [
		{ "url": "https://files.progdvb.com/progfinder/ProgFinderSetup{version}x86.exe", "architecture": "x86" },
		{ "url": "https://files.progdvb.com/progfinder/ProgFinderSetup{version}x64.exe", "architecture": "x64" }
	]
}
