{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.papercut.com/products/ng/release-history/all",
		"regex": "release-version\">(?<version>(?<major>\\d+)\\.\\d+\\.\\d+)</h2>\\s*<div class=\"[^\"]*build-number\">Build (?<build>\\d+)<"
	},
	"version": "{version}.{captures.build}",
	"urls": [
		"https://cdn.papercut.com/web/products/ng-mf/installers/ng/{captures.major}.x/pcng-setup-{version}.{captures.build}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.papercut.com/products/ng/release-history/all#{version|.|}"
	}
}
