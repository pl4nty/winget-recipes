{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
		"regex": "\"FIREFOX_DEVEDITION\":\\s*\"(?<build>(?<version>\\d+\\.\\d+)b\\d+)\""
	},
	"urls": [
		"https://download-installer.cdn.mozilla.net/pub/devedition/releases/{captures.build}/win32/ca/Firefox%20Setup%20{captures.build}.exe",
		"https://download-installer.cdn.mozilla.net/pub/devedition/releases/{captures.build}/win64/ca/Firefox%20Setup%20{captures.build}.exe",
		"https://download-installer.cdn.mozilla.net/pub/devedition/releases/{captures.build}/win64-aarch64/ca/Firefox%20Setup%20{captures.build}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.firefox.com/en-US/firefox/{version}beta/releasenotes/"
	}
}
