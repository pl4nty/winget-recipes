{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.mitk.org/download/releases/",
		"regex": "href=\"MITK-(\\d{4}\\.\\d{2}(?:\\.\\d+)?)/\""
	},
	"urls": [
		"https://www.mitk.org/download/releases/MITK-{version}/MITK-v{version}-windows-x86_64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/MITK/MITK/releases/tag/v{version}"
	}
}
