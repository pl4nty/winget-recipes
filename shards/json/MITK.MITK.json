{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.mitk.org/download/releases/",
		"regex": "href=\"MITK-(\\d{4}\\.\\d{2}(?:\\.\\d+)?)/\""
	},
	"urls": [
		{
			"url": "https://www.mitk.org/download/releases/MITK-{version}/MITK-v{version}-windows-x86_64.exe",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/MITK/MITK/releases/tag/v{version}"
	}
}
