{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.agisoft.com/downloads/installer/",
		"regex": "download\\.agisoft\\.com/metashape-pro_(?<version>\\d+_\\d+_\\d+)_x64\\.msi"
	},
	"version": "{version|_|.}",
	"urls": [
		"https://download.agisoft.com/metashape-pro_{captures.version}_x64.msi",
		"https://download.agisoft.com/metashape-pro_{captures.version}_x86.msi",
		"https://download.agisoft.com/metashape-pro_{captures.version}_arm64.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.agisoft.com/pdf/metashape_changelog.pdf"
	}
}
