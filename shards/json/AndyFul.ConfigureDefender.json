{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-commit",
	"github": {
		"owner": "AndyFul",
		"repo": "ConfigureDefender",
		"path": "ConfigureDefender.exe"
	},
	"version": {
		"source": "product"
	},
	"urls": [
		"https://raw.githubusercontent.com/AndyFul/ConfigureDefender/{github.commit}/ConfigureDefender.exe"
	],
	"state": {
		"source": "value",
		"value": "{github.commit}"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/AndyFul/ConfigureDefender/blob/{github.commit}/What_is_new.txt"
	}
}
