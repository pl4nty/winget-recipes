{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://learn.microsoft.com/en-us/windows/apps/windows-app-sdk/release-notes/windows-app-sdk-1-3?pivots=stable",
		"regex": "<h2 id=\"(?<anchor>version-13\\d+-\\d+)\">Version (?<version>1\\.3\\.\\d+) \\((?<build>1\\.3\\.\\d+)\\)"
	},
	"urls": [
		"https://aka.ms/windowsappsdk/1.3/{captures.build}/windowsappruntimeinstall-x64.exe",
		"https://aka.ms/windowsappsdk/1.3/{captures.build}/windowsappruntimeinstall-x86.exe",
		"https://aka.ms/windowsappsdk/1.3/{captures.build}/windowsappruntimeinstall-arm64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://learn.microsoft.com/en-us/windows/apps/windows-app-sdk/release-notes/windows-app-sdk-1-3?pivots=stable#{captures.anchor}"
	}
}
