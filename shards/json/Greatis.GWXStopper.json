{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://greatis.com/blog/what-is-gwx-gwx-exe",
		"regex": "GWX Stopper version: (?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{
			"url": "https://www.greatis.com/stop-gwx-from-startup.zip",
			"nestedInstallerMatches": [
				"GWXStopper_setup.exe"
			]
		}
	],
	"replace": true
}
