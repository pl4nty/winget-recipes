{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://kpym.com/2/kpym/download.htm",
		"regex": "/download/kts(?<major>\\d)(?<minor>\\d+[a-z]?)\\.exe"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		"https://kpym.com/download/kts{captures.major}{captures.minor}.exe"
	]
}
