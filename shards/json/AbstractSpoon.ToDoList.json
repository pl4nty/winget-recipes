{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://github.com/abstractspoon/ToDoList_Downloads/commits/master/Latest/todolist_exe.zip.atom",
		"regex": "Commit/(?<sha>[0-9a-f]{40})</id>\\s*<link[^>]*/>\\s*<title>\\s*Update todolist_exe\\.zip to (?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		"https://github.com/abstractspoon/ToDoList_Downloads/raw/{captures.sha}/Latest/todolist_exe.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://abstractspoon.com/"
	}
}
