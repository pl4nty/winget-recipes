{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "http://update.milvus.com.br/?prefix=downloads/",
		"regex": "downloads/(\\d+(?:\\.\\d+)+)/x64/Milvus\\.Helpdesk\\.Agente\\.Setup\\.msi"
	},
	"urls": [
		{
			"url": "https://update.milvus.com.br/downloads/{version}/x64/Milvus.Helpdesk.Agente.Setup.msi",
			"architecture": "x64"
		},
		{
			"url": "https://update.milvus.com.br/downloads/{version}/x86/Milvus.Helpdesk.Agente.Setup.msi",
			"architecture": "x86"
		}
	]
}
