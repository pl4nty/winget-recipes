{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.scia.net/en/support/downloads",
		"regex": "setup/25/release_(?<version>25\\.\\d+\\.\\d+)\\.zip"
	},
	"urls": [
		{ "url": "https://downloads.scia.net/support/sciaengineer/setup/25/release_{version}.zip", "nestedInstallerMatches": ["DISK1/SCIAEngineer25.0.msi"] }
	]
}
