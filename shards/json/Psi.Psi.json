{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://sourceforge.net/projects/psi/rss?path=/Psi",
		"regex": "/files/Psi/[^/]+/psi-(\\d+(?:\\.\\d+)+)-win64-setup\\.exe/download"
	},
	"urls": [
		"https://sourceforge.net/projects/psi/files/Psi/{version}/psi-{version}-win64-setup.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/psi-im/psi/blob/master/CHANGELOG"
	}
}
