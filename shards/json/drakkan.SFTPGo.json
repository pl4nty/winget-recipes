{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "drakkan",
		"repo": "sftpgo"
	},
	"version": "v{version}",
	"urls": [
		"https://github.com/drakkan/sftpgo/releases/download/{github.rawTag}/sftpgo_{github.rawTag}_windows_x86_64.exe",
		{
			"url": "https://github.com/drakkan/sftpgo/releases/download/{github.rawTag}/sftpgo_{github.rawTag}_windows_portable.zip",
			"architecture": "x64",
			"nestedInstallerMatches": [
				"sftpgo.exe"
			]
		},
		"https://github.com/drakkan/sftpgo/releases/download/{github.rawTag}/sftpgo_{github.rawTag}_windows_x86.exe",
		{
			"url": "https://github.com/drakkan/sftpgo/releases/download/{github.rawTag}/sftpgo_{github.rawTag}_windows_portable.zip",
			"architecture": "x86",
			"nestedInstallerMatches": [
				"x86/sftpgo.exe"
			]
		},
		"https://github.com/drakkan/sftpgo/releases/download/{github.rawTag}/sftpgo_{github.rawTag}_windows_arm64.exe",
		{
			"url": "https://github.com/drakkan/sftpgo/releases/download/{github.rawTag}/sftpgo_{github.rawTag}_windows_portable.zip",
			"architecture": "arm64",
			"nestedInstallerMatches": [
				"arm64/sftpgo.exe"
			]
		}
	]
}
