{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/metadata-viewer/",
		"regex": "<span class=\"notranslate\">Metadata Viewer (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/metadata-viewer.exe", "https://files.vovsoft.com/metadata-viewer-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/metadata-viewer/"
	}
}
