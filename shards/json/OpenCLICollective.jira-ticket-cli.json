{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "open-cli-collective",
		"repo": "atlassian-cli",
		"method": "api-list",
		"tagRegex": "^jtk-v"
	},
	"urls": [
		"https://github.com/open-cli-collective/atlassian-cli/releases/download/{github.rawTag}/jtk_{version}_windows_amd64.zip",
		"https://github.com/open-cli-collective/atlassian-cli/releases/download/{github.rawTag}/jtk_{version}_windows_arm64.zip"
	]
}
