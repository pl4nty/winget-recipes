{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "karnyadavdev",
		"repo": "FontWizard",
		"method": "api-latest",
		"assetRegex": "\\.exe$"
	},
	"version": {
		"source": "product"
	},
	"state": {
		"source": "value",
		"value": "{github.rawTag}"
	}
}
