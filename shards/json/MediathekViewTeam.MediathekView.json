{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://download.mediathekview.de/stabil/updates-win.xml",
		"regex": "newVersion=\"(?<version>\\d+(?:\\.\\d+)+)\""
	},
	"urls": [
