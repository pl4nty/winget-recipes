{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/sitemap-generator/",
		"regex": "<span class=\"notranslate\">Sitemap Generator (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/sitemap-generator.exe", "https://files.vovsoft.com/sitemap-generator-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/sitemap-generator/"
	}
}
