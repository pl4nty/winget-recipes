{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://gen.hardcopy.de/news.php",
		"regex": "<U><B>Version (\\d{4}\\.\\d{2}\\.\\d{2})</B>"
	},
	"urls": [
		"https://hardcopy.de/hc.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://gen.hardcopy.de/news.php#:~:text={version}"
	}
}
