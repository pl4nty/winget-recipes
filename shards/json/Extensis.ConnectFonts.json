{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.extensis.com/support/connect-fonts/release-notes",
		"regex": "Connect desktop for Windows:\\s*(\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{
			"url": "https://bin.extensis.com/ConnectFonts-W-{version|.|-}.zip",
			"nestedInstallerMatches": [" Connect v"]
		}
	]
}
