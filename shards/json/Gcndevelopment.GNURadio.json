{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "http://www.gcndevelopment.com/gnuradio/downloads.htm",
		"regex": "downloads/installers/v(?<version>\\d+(?:\\.\\d+)+)/(?<file>gnuradio_\\d+(?:\\.\\d+)+_win64\\.msi)"
	},
