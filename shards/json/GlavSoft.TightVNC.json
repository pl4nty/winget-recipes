{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.tightvnc.com/download.php",
		"regex": "/tightvnc-(\\d+(?:\\.\\d+)+)-gpl-setup-64bit\\.msi\""
	},
	"urls": [
		"https://www.tightvnc.com/download/{version}/tightvnc-{version}-gpl-setup-32bit.msi",
		"https://www.tightvnc.com/download/{version}/tightvnc-{version}-gpl-setup-64bit.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.tightvnc.com/whatsnew.php"
	}
}
