{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://origin.cdn.kde.org/ci-builds/office/alkimia/master/windows/",
		"regex": "alkimia-master-(\\d+)-windows-cl-msvc2022-x86_64\\.exe"
	},
	"version": {
		"source": "display"
	},
	"urls": [
		{
			"url": "https://origin.cdn.kde.org/ci-builds/office/alkimia/master/windows/alkimia-master-{version}-windows-cl-msvc2022-x86_64.exe",
			"architecture": "x64"
		}
	]
}
