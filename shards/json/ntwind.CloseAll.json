{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ntwind.com/software/closeall.html",
		"regex": "CloseAll_(?<version>\\d+(?:\\.\\d+)+)-setup\\.exe"
	},
	"urls": [
		{ "url": "https://www.ntwind.com/files/CloseAll_{version}-setup.exe", "architecture": "x86" },
		{ "url": "https://www.ntwind.com/files/CloseAll_{version}-setup.exe", "architecture": "x64" }
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ntwind.com/software/closeall/what-is-new.html"
	}
}
