{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "Mudlet",
		"repo": "Mudlet",
		"method": "api-sort",
		"tagRegex": "^Mudlet-(?=\\d+(?:\\.\\d+)+$)",
		"assetRegex": "-windows-64-installer\\.exe$"
	},
	"urls": ["https://github.com/Mudlet/Mudlet/releases/download/{github.rawTag}/Mudlet-{version}-windows-64-installer.exe"]
}
