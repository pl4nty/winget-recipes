{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.opencascade.com/products/cad-assistant/",
		"regex": "occt/applications/cad_assistant_(?<version>\\d+(?:\\.\\d+)+)_(?<date>\\d{4}-\\d{2}-\\d{2})_win64\\.exe"
	},
	"urls": ["https://www.opencascade.com/sites/default/files/private/occt/applications/cad_assistant_{version}_{captures.date}_win64.exe"]
}
