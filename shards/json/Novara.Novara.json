{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "Novara-owner",
		"repo": "Novara-Vault",
		"method": "api-sort",
		"tagRegex": "^novara(?=\\d+$)"
	},
	"version": "{version}.0.0",
	"urls": [
		"https://github.com/Novara-owner/Novara-Vault/releases/download/{github.rawTag}/Novara_Setup_{github.rawTag}.exe"
	]
}
