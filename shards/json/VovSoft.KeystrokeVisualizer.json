{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/keystroke-visualizer/",
		"regex": "<span class=\"notranslate\">Keystroke Visualizer (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/keystroke-visualizer.exe", "https://files.vovsoft.com/keystroke-visualizer-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/keystroke-visualizer/"
	}
}
