{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "hiddify",
		"repo": "hiddify-app",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "^v(?=\\d)"
