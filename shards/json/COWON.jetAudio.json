{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.jetaudio.com/download/",
		"regex": "https://www\\.jetaudio\\.com/download/(?<dir>[0-9a-f-]+)/jetAudio/JAD(?<major>\\d)(?<minor>\\d)(?<version>\\d+)_BASIC\\.exe"
	},
	"version": "{captures.major}.{captures.minor}.{captures.version}",
	"urls": [
		"https://www.jetaudio.com/download/{captures.dir}/jetAudio/JAD{captures.major}{captures.minor}{captures.version}_BASIC.exe"
	]
}
