{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "oneclick",
		"repo": "rubyinstaller2",
		"method": "api-list",
		"tagRegex": "^RubyInstaller-3\\.1\\.\\d+-\\d+$",
		"perPage": 100
	},
	"version": "{github.rawTag|RubyInstaller-|}",
	"urls": [
		"https://github.com/oneclick/rubyinstaller2/releases/download/{github.rawTag}/rubyinstaller-{github.rawTag|RubyInstaller-|}-x86.exe",
		"https://github.com/oneclick/rubyinstaller2/releases/download/{github.rawTag}/rubyinstaller-{github.rawTag|RubyInstaller-|}-x64.exe"
	]
}
