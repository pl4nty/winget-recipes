{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.hoptodesk.com/download",
		"regex": "data-file=\"HopToDesk64\\.exe\">v(?<version>\\d+(?:\\.\\d+)+),"
	},
	"urls": [
		"https://dl.hoptodesk.com/releases/{version}/HopToDesk64.exe",
		"https://dl.hoptodesk.com/releases/{version}/HopToDesk.exe",
		"https://dl.hoptodesk.com/releases/{version}/hoptodesk-arm64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.hoptodesk.com/changelog"
	}
}
