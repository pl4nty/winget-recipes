		"owner": "tuyenvm",
		"repo": "OpenKey"
	},
	"urls": [
		{
			"url": "https://github.com/tuyenvm/OpenKey/releases/download/{github.rawTag}/OpenKey64-Windows-{version}-RC.zip",
