{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.eclipse.org/downloads/",
		"regex": "/oomph/epp/(?<version>\\d{4}-\\d{2})/R/eclipse-inst-jre-win64\\."
	},
	"version": "{version|-|.}",
	"urls": [
		{ "url": "https://download.eclipse.org/oomph/epp/{version}/R/eclipse-inst-jre-win64.zip", "architecture": "x64" },
		{ "url": "https://download.eclipse.org/oomph/epp/{version}/R/eclipse-inst-jre-win-aarch64.zip", "architecture": "arm64" }
	]
}
