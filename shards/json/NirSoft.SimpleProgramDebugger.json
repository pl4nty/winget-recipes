{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.nirsoft.net/utils/simple_program_debugger.html",
		"regex": "Versions History</h4>\\s*<ul[^>]*>\\s*<li>Version (?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{
			"url": "https://www.nirsoft.net/utils/simpleprogramdebugger.zip",
			"architecture": "x86"
		},
		"https://www.nirsoft.net/utils/simpleprogramdebugger-x64.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.nirsoft.net/utils/simple_program_debugger.html#:~:text=Versions%20History"
	},
	"replace": true
}
