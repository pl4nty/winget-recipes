{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.winimage.com/download.htm",
		"regex": "download/wima64(?<version>(?<major>\\d+)(?<minor>\\d))\\.zip"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		{
			"url": "https://www.winimage.com/download/winima{captures.version}.zip",
			"architecture": "x86"
		},
		{
			"url": "https://www.winimage.com/download/wima64{captures.version}.zip",
			"architecture": "x64"
		},
		{
			"url": "https://www.winimage.com/download/wima64{captures.version}_arm64.zip",
			"architecture": "arm64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.winimage.com/winimage.htm"
	}
}
