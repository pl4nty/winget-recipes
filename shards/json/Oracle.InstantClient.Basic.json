{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.oracle.com/database/technologies/instant-client/winx64-64-downloads.html",
		"regex": "instantclient/(?<dir>\\d+)/instantclient-basic-windows\\.x64-(?<version>\\d+(?:\\.\\d+)+)\\.zip"
	},
	"urls": [
		"https://download.oracle.com/otn_software/nt/instantclient/{captures.dir}/instantclient-basic-windows.x64-{version}.zip"
	]
}
