{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "http://tesseract.gg/",
		"regex": "tesseract_(?<version>\\d{4}_\\d{2}_\\d{2})_(?<edition>[a-z_]+?)_windows\\.exe"
	},
	"version": "{version|_|.}",
	"urls": [
		"https://download.tuxfamily.org/tesseract/tesseract_{version}_{captures.edition}_windows.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "http://tesseract.gg/"
	}
}
