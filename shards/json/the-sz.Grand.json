{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://the-sz.com/products/grand/",
		"regex": "Product: 'grand', Link[^>]*title=\"Version (\\d+(?:\\.\\d+)+) &middot;"
	},
	"urls": [
		"https://the-sz.com/products/grand/history/{version}/Grand.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://the-sz.com/common/history.php?product=grand"
	},
	"cleanup": false
}
