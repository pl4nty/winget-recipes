{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.visualsvn.com/server/download/",
		"regex": "/files/VisualSVN-Server-(\\d+(?:\\.\\d+)+)-x64\\.msi"
	},
	"version": "{version}.0",
	"urls": [
		"https://www.visualsvn.com/files/VisualSVN-Server-{version}-x64.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.visualsvn.com/server/changes/"
	}
}
