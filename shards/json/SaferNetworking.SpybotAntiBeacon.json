{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://www.safer-networking.org/antibeaconallocator.php"
		],
		"regex": "/SpybotAntiBeacon-(\\d+(?:\\.\\d+)+)-setup\\.exe$"
	},
