{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.oo-software.com/en/oodeskinfo/changelog",
		"regex": "Version (\\d+\\.\\d+\\.\\d+) (?:–|&ndash;|-) released"
	},
	"urls": ["https://package.oo-software.com/winget/deskinfo/{version}/oodeskinfo_{version}_x64.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.oo-software.com/en/oodeskinfo/changelog"
	}
}
