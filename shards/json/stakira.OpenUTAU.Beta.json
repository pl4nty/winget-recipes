{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "openutau",
		"repo": "OpenUtau",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "-beta$",
		"perPage": 100
	},
	"urls": [
		"https://github.com/openutau/OpenUtau/releases/download/{github.rawTag}/OpenUtau-win-x64.exe",
		"https://github.com/openutau/OpenUtau/releases/download/{github.rawTag}/OpenUtau-win-arm64.exe"
	]
}
