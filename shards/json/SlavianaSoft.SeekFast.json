{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://seekfast.org/download-seekfast",
		"regex": "Latest version:\\s*(\\d+(?:\\.\\d+)+)"
