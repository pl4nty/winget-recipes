{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://dengine.net/windows",
		"regex": "doomsday_(?<version>\\d+(?:\\.\\d+)+)_x64\\.msi"
	},
	"version": {
		"source": "product"
	},
