{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ni.com/en/support/downloads/drivers/download.system-configuration.html",
		"regex": "/ni-system-configuration/(?<short>\\d+\\.\\d+)/offline/ni-system-configuration_(?<version>\\d+\\.\\d+\\.\\d+)_offline\\.iso(?![\\s\\S]*/ni-system-configuration/\\d+\\.\\d+/offline/ni-system-configuration_\\d)"
	},
	"urls": [
		{
			"url": "https://download.ni.com/support/nipkg/products/ni-s/ni-system-configuration/{captures.short}/online/ni-system-configuration_{captures.short}_online.exe",
			"architecture": "x64"
		}
	]
}
