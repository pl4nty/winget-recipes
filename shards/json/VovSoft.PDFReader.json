{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/pdf-reader/",
		"regex": "<span class=\"notranslate\">PDF Reader (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/pdf-reader.exe", "https://files.vovsoft.com/pdf-reader-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/pdf-reader/"
	}
}
