{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://crashpro-inference.psynect.workers.dev/releases/latest-installer.json",
		"regex": "^(?=[\\s\\S]*?\"version\":\\s*\"(?<version>[^\"]+)\")(?=[\\s\\S]*?\"installer_url\":\\s*\"(?<url>[^\"]+)\")"
	},
	"urls": ["{captures.url}"],
	"releaseNotes": {
		"releaseNotesUrl": "https://omnimend.com/changelog"
	}
}
