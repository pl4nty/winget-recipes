{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://line6.com/software/Line%206%20Central",
		"regex": "<b>Version (?<version>\\d+(?:\\.\\d+)+)</b>(?:(?!software-results)[\\s\\S])*?Compatible OS:</b>\\s*Windows(?:(?!software-results)[\\s\\S])*?(?:readeula\\.html|getrelease)\\?rid=(?<rid>\\d+)"
	},
	"urls": [
		"https://line6.com/getrelease?rid={captures.rid}"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://line6.com/software/Line%206%20Central"
	}
}
