{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.kensington.com/software/kensingtonworks/",
		"regex": "/siteassets/software-support/kensingtonworks/(?<dir>[^/\"']+)/kensingtonworks_(?<version>\\d+(?:\\.\\d+)+)_(?<ts>\\d+)\\.msi"
	},
