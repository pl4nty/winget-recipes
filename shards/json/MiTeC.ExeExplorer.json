{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.mitec.cz/wp/xml/vh_exe.xml",
		"regex": "<VERSION>(\\d+(?:\\.\\d+)+)</VERSION>"
	},
	"urls": [
		{
			"url": "https://www.mitec.cz/wp/files/EXE.zip",
			"architecture": "x64",
			"nestedInstallerMatches": ["EXE64.exe", "EXE.exe"]
		},
		{
			"url": "https://www.mitec.cz/wp/files/EXE.zip",
			"architecture": "x86",
			"nestedInstallerMatches": ["EXE.exe"]
		}
	],
	"releaseNotes": { "releaseNotesUrl": "https://www.mitec.cz/wp/xml/vh_exe.xml" }
}
