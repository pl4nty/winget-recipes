{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://spring.io/tools",
		"regex": "/release/dist/(?<version>\\d+(?:\\.\\d+)+)\\.RELEASE/(?<eclipse>e\\d+(?:\\.\\d+)+)/spring-tools-for-eclipse-\\d+(?:\\.\\d+)+\\.RELEASE-(?<build>e\\d+(?:\\.\\d+)+)-win32\\.win32\\.x86_64\\.zip"
	},
	"version": "{version}.{captures.build}",
	"urls": [
		"https://cdn.spring.io/spring-tools/release/dist/{version}.RELEASE/{captures.eclipse}/spring-tools-for-eclipse-{version}.RELEASE-{captures.build}-win32.win32.x86_64.zip"
	]
}
