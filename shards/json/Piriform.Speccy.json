{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ccleaner.com/speccy/version-history",
		"regex": "version-history__latest-version\">v(?<version>\\d+\\.\\d+)\\.\\d+<"
	},
	"urls": ["https://download.ccleaner.com/spsetup.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ccleaner.com/speccy/version-history"
	}
}
