{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-commit",
	"github": {
		"owner": "SagMeinenNamen",
		"repo": "SecretChat",
		"path": "Output/SecretChat-Installer.exe"
	},
	"version": {
		"source": "display"
	},
	"urls": [
		"https://raw.githubusercontent.com/SagMeinenNamen/SecretChat/{github.commit}/Output/SecretChat-Installer.exe"
	],
	"state": {
		"source": "value",
		"value": "{github.commit}"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/SagMeinenNamen/SecretChat/commits/main"
	}
}
