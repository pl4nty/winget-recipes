{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.plogue.com/downloads.html",
		"regex": "WIN_sforzando_v(?<major>\\d+)\\.(?<a>\\d)(?<b>\\d)(?<c>\\d)\\.exe"
	},
	"version": "{captures.major}.{captures.a}.{captures.b}.{captures.c}",
	"urls": [
		"https://s3.amazonaws.com/sforzando/WIN_sforzando_v{captures.major}.{captures.a}{captures.b}{captures.c}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.plogue.com/products/sforzando.html"
	}
}
