{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/hugin/best_release.json",
		"regex": "/hugin/hugin-(?<series>\\d+\\.\\d+)/Hugin-(?<version>\\d+(?:\\.\\d+)+)-win64\\.msi"
	},
