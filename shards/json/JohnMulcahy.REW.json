{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.roomeqwizard.com/",
		"regex": "installers/REW_windows-x64_(?<version>\\d+(?:_\\d+)+)\\.exe"
	},
	"version": "{version|_|.}",
	"urls": [
		"https://www.roomeqwizard.com/installers/REW_windows-x64_{version}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.roomeqwizard.com/changehistory.html"
	}
}
