{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.notch.one/downloads",
		"regex": "NotchLC_QuicktimeAVI/NotchLC_Quicktime_AVI_Plugin_(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
