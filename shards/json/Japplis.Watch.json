{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.japplis.com/watch/version.txt",
		"regex": "^\\s*(\\d+(?:\\.\\d+)+)\\s*$"
	},
	"urls": [
		"https://www.japplis.com/watch/versions/Watch-{version}.exe",
		"https://www.japplis.com/watch/versions/Watch-{version}.exe",
		"https://www.japplis.com/watch/Watch.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.japplis.com/watch/changes.txt"
	}
}
