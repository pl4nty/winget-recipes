{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://downloads.imagej.net/fiji/archive/latest/?C=N;O=D",
		"regex": "href=\"(\\d{8}-\\d{4})/\""
	},
	"urls": [
		{
			"url": "https://downloads.imagej.net/fiji/archive/latest/{version}/fiji-latest-portable-nojava.zip",
			"architecture": "x64",
			"nestedInstallerMatches": [
				"Fiji/fiji-windows-x64.exe"
			]
		},
		{
			"url": "https://downloads.imagej.net/fiji/archive/latest/{version}/fiji-latest-portable-nojava.zip",
			"architecture": "arm64",
			"nestedInstallerMatches": [
				"Fiji/fiji-windows-arm64.exe"
			]
		}
	]
}
