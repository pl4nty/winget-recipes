{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.modbustools.com/download.html",
		"regex": "Modbus Slave version (\\d+(?:\\.\\d+)+) Build (?<build>\\d+)"
	},
	"version": "{version}.{captures.build}",
	"urls": [
		"https://www.modbustools.com/download/ModbusSlaveSetup32Bit.exe",
		"https://www.modbustools.com/download/ModbusSlaveSetup64Bit.exe",
		"https://www.modbustools.com/download/ModbusSlaveSetupARM64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.modbustools.com/ModSlaveChangeLog.txt"
	},
	"replace": true
}
