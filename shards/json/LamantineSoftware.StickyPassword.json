{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.stickypassword.com/download",
		"regex": "(?<file>StickyPassword_rev(?<major>\\d)(?<minor>\\d)(?<patch>\\d+?)(?<version>\\d{4})\\.exe)"
	},
	"version": "{captures.major}.{captures.minor}.{captures.patch}.{version}",
	"urls": ["https://downloads.stickypassword.com/files/SP7/{captures.file}"],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.stickypassword.com/download"
	}
}
