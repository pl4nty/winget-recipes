{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "ruffle-rs",
		"repo": "ruffle",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "^nightly-"
	},
	"version": { "source": "product" },
	"urls": [
		{
			"url": "https://github.com/ruffle-rs/ruffle/releases/download/{github.rawTag}/ruffle-nightly-{version|-|_}-windows-x86_32.zip",
			"nestedInstallerMatches": ["setup.msi"]
		},
		{
			"url": "https://github.com/ruffle-rs/ruffle/releases/download/{github.rawTag}/ruffle-nightly-{version|-|_}-windows-x86_32.zip",
			"nestedInstallerMatches": ["ruffle.exe"]
		},
		{
			"url": "https://github.com/ruffle-rs/ruffle/releases/download/{github.rawTag}/ruffle-nightly-{version|-|_}-windows-x86_64.zip",
			"nestedInstallerMatches": ["setup.msi"]
		},
		{
			"url": "https://github.com/ruffle-rs/ruffle/releases/download/{github.rawTag}/ruffle-nightly-{version|-|_}-windows-x86_64.zip",
			"nestedInstallerMatches": ["ruffle.exe"]
		}
	]
}
