{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/gnuwin32/rss?path=/m4",
		"regex": "/gnuwin32/files/m4/(?<version>\\d+(?:\\.\\d+)+(?:-\\d+)?)/m4-"
	},
	"version": "{version}.0",
	"urls": [
		"https://sourceforge.net/projects/gnuwin32/files/m4/{version}/m4-{version}-setup.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://gnuwin32.sourceforge.net/packages/m4.htm"
	}
}
