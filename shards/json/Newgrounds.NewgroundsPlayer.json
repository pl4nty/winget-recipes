{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.newgrounds.com/flash/player",
		"regex": "downloads/ngplayer/v(?<version>\\d+(?:\\.\\d+)+)/Install_Newgrounds_Player\\.msi"
	},
	"version": {
		"source": "product"
	},
	"urls": [
		"https://www.newgrounds.com/downloads/ngplayer/v{captures.version}/Install_Newgrounds_Player.msi"
	],
	"state": {
		"source": "value",
		"value": "{captures.version}"
	}
}
