{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://kicad-downloads.s3.cern.ch/?prefix=windows/stable/",
		"regex": "windows/stable/kicad-(\\d+(?:\\.\\d+)+)_1-x86_64-lite\\.exe"
	},
	"urls": [
		"https://kicad-downloads.s3.cern.ch/windows/stable/kicad-{version}_1-x86_64-lite.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.kicad.org/blog/"
	}
}
