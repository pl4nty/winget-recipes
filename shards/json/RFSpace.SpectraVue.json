{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "http://www.rfspace.com/RFSPACE/SVDownload.html",
		"regex": "files/SpectraVueSetup(?<version>(?<major>\\d)(?<minor>\\d+))\\.exe"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		{
			"url": "http://www.rfspace.com/files/SpectraVueSetup{captures.version}.exe",
			"architecture": "x86"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "http://www.rfspace.com/RFSPACE/SVDownload.html"
	}
}
