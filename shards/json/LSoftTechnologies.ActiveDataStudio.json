{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.disktools.com/history/",
		"regex": "<strong>Version (?<version>\\d+(?:\\.\\d+)+)</strong>"
	},
	"urls": [
		{
			"url": "https://software.lsoft.net/ActiveDataStudioSetup.exe",
			"architecture": "x86"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.disktools.com/history/"
	},
	"replace": true
}
