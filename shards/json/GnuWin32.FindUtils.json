{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/gnuwin32/rss?path=/findutils",
		"regex": "/gnuwin32/files/findutils/(?<version>\\d+(?:\\.\\d+)+(?:-\\d+)?)/findutils-\\k<version>\\.exe/download"
	},
	"urls": [
		{
			"url": "https://sourceforge.net/projects/gnuwin32/files/findutils/{version}/findutils-{version}.exe/download",
			"architecture": "x86"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://gnuwin32.sourceforge.net/packages/findutils.htm"
	}
}
