{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"version": {
		"source": "display"
	},
	"github": {
		"owner": "ojdkbuild",
		"repo": "ojdkbuild",
		"method": "api-sort",
		"tagRegex": "^java-17-openjdk-(?=\\d)",
		"perPage": 100
	},
	"urls": [
		"https://github.com/ojdkbuild/ojdkbuild/releases/download/{github.rawTag}/{github.rawTag}.win.x86_64.msi"
	]
}
