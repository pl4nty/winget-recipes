			"url": "https://downloadmirror.intel.com/{captures.id}/CSME_Version_Detection_Tool_Windows_{captures.file}.zip",
			"nestedInstallerMatches": ["DiscoveryTool.GUI/CSME-Version-Detection-Tool.exe"]
