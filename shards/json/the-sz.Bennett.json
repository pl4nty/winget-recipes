{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://the-sz.com/products/bennett/",
		"regex": "Version (\\d+(?:\\.\\d+)+) &middot;"
	},
