{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.virtual-serial-port.org/",
		"regex": "class=\"softwareVersion\">(\\d+(?:\\.\\d+)+)<"
	},
	"urls": [
		"https://cdn.electronic.us/products/vspd/windows/download/vspd.exe"
	],
	"replace": true
}
