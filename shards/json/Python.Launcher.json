{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.python.org/downloads/windows/",
		"regex": "Latest Python 3 Release - Python (\\d+\\.\\d+\\.\\d+)"
	},
	"urls": ["https://www.python.org/ftp/python/{version}/win32/launcher.msi"]
}
