{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://razorsql.com/download_win.html",
		"regex": "downloads/(\\d+_\\d+_\\d+)/razorsql\\d+_\\d+_\\d+_setup_x64\\.exe"
	},
	"version": "{version|_|.}",
	"urls": [
		"https://s3.dualstack.us-east-1.amazonaws.com/downloads.razorsql.com/downloads/{version}/razorsql{version}_setup_x64.exe",
		"https://s3.dualstack.us-east-1.amazonaws.com/downloads.razorsql.com/downloads/{version}/razorsql{version}_setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://razorsql.com/updates.html"
	}
}
