{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.cogin.com/mq/download.php",
		"regex": "download\\.php\\?file=(\\d+(?:\\.\\d+)+)%2FQueueExplorer"
	},
