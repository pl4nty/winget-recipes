	"urls": [
		{
			"url": "https://files.vovsoft.com/json-to-csv-converter.exe",
			"architecture": "x64"
		},
		"https://files.vovsoft.com/json-to-csv-converter-portable.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/json-to-csv-converter/"
	}
}
