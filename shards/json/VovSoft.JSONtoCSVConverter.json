{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/json-to-csv-converter/",
		"regex": "<span class=\"notranslate\">JSON to CSV Converter (?<version>\\d+\\.\\d+)</span>"
	},
