{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.e-sword.net/downloads.html",
		"regex": "href=\"files/e-sword_(\\d+)_setup\\.exe\""
	},
	"version": {
		"source": "display"
	},
	"urls": [
		"https://www.e-sword.net/files/e-sword_{version}_setup.exe"
	],
	"state": {
		"source": "value",
		"value": "{version}"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://www.e-sword.net/downloads.html"
	}
}
