{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ni.com/en/support/downloads/drivers/download.ni-visa.html",
		"regex": "/ni-visa/(?<short>\\d+\\.\\d+)/offline/ni-visa_(?<version>\\d+\\.\\d+\\.\\d+)_offline\\.iso(?![\\s\\S]*/ni-visa/\\d+\\.\\d+/offline/ni-visa_\\d)"
	},
	"urls": [
		{
			"url": "https://download.ni.com/support/nipkg/products/ni-v/ni-visa/{captures.short}/online/ni-visa_{captures.short}_online.exe",
			"architecture": "x64"
		}
	]
}
