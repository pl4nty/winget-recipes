{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/picture-puzzle/",
		"regex": "<span class=\"notranslate\">Picture Puzzle (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
