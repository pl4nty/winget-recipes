{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "nvaccess",
		"repo": "nvda",
		"method": "api-list",
		"kind": "all",
		"tagRegex": "^release-(?=\\d+\\.\\d+(?:\\.\\d+)?rc\\d+$)"
	},
	"urls": ["https://github.com/nvaccess/nvda/releases/download/{github.rawTag}/nvda_{version}.exe"]
}
