{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.nirsoft.net/utils/outlook_nk2_edit.html",
		"regex": "Versions History</h4>\\s*<ul[^>]*>\\s*<li>Version (?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{
			"url": "https://www.nirsoft.net/utils/nk2edit_setup.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.nirsoft.net/utils/nk2edit.zip",
			"architecture": "x86"
		},
		"https://www.nirsoft.net/utils/nk2edit-x64.zip",
		{
			"url": "https://www.nirsoft.net/utils/nk2edit-32-64.zip",
			"architecture": "neutral"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.nirsoft.net/utils/outlook_nk2_edit.html#:~:text=Versions%20History"
	},
	"replace": true
}
