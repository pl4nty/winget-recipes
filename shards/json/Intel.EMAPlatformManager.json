{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.intel.com/content/www/us/en/download/19449/intel-endpoint-management-assistant-intel-ema.html",
		"regex": "downloadmirror\\.intel\\.com/(?<id>\\d+)/Ema_Install_Package_(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		{
			"url": "https://downloadmirror.intel.com/{captures.id}/Ema_Install_Package_{version}.exe",
			"nestedInstallerMatches": [
				"PlatformManager.msi"
			]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://downloadmirror.intel.com/{captures.id}/Intel_EMA_{version}_Release_Notes.pdf"
	}
}
