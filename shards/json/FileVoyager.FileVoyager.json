{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.filevoyager.com/download/",
		"regex": "FileVoyager_x64_Setup_(?<version>\\d+(?:\\.\\d+)+)_Lite\\.exe"
	},
	"urls": [
		"https://www.filevoyager.com/wp-content/uploads/FileVoyager_x64_Setup_{version}_Lite.exe",
		"https://www.filevoyager.com/wp-content/uploads/FileVoyager_x86_Setup_{version}_Lite.exe"
	]
}
