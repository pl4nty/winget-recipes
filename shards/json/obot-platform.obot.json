{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "obot-platform",
		"repo": "obot",
		"method": "api-sort",
		"kind": "stable",
		"assetRegex": "_windows_(?:amd64|arm64)\\.zip$"
	},
	"version": "{github.rawTag}",
	"urls": [
		"https://github.com/obot-platform/obot/releases/download/{github.rawTag}/obot_{github.rawTag}_windows_amd64.zip",
		"https://github.com/obot-platform/obot/releases/download/{github.rawTag}/obot_{github.rawTag}_windows_arm64.zip"
	]
}
