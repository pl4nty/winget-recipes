{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "paolosalvatori",
		"repo": "ServiceBusExplorer",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "-preview$"
	},
	"urls": [
		"https://github.com/paolosalvatori/ServiceBusExplorer/releases/download/{github.rawTag}/ServiceBusExplorer-{github.rawTag}.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/paolosalvatori/ServiceBusExplorer/releases/tag/{github.rawTag}"
	}
}
