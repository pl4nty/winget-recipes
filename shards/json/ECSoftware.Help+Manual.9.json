{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.helpandmanual.com/downloads.html",
		"regex": "help-and-manual-setup-v(?<major>9)(?<minor>\\d)(?<patch>\\d)\\.exe"
	},
	"version": "{captures.major}.{captures.minor}.{captures.patch}",
	"urls": [
		"https://www.helpandmanual.com/download/help-and-manual-setup-v{captures.major}{captures.minor}{captures.patch}.exe",
		"https://www.helpandmanual.com/download/help-and-manual-setup-v{captures.major}{captures.minor}{captures.patch}.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.helpandmanual.com/news/"
	},
	"cleanup": false
}
