{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://learn.microsoft.com/en-us/windows/apps/windows-app-sdk/release-notes/windows-app-sdk-1-1?pivots=stable",
		"regex": "<h2 id=\"(?<anchor>version-11\\d+)\">Version (?<version>1\\.1\\.\\d+)</h2>"
	},
	"urls": [
		"https://aka.ms/windowsappsdk/1.1/{version}/windowsappruntimeinstall-x64.exe",
		"https://aka.ms/windowsappsdk/1.1/{version}/windowsappruntimeinstall-x86.exe",
		"https://aka.ms/windowsappsdk/1.1/{version}/windowsappruntimeinstall-arm64.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://learn.microsoft.com/en-us/windows/apps/windows-app-sdk/release-notes/windows-app-sdk-1-1?pivots=stable#{captures.anchor}"
	}
}
