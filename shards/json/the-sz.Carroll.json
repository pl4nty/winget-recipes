{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://the-sz.com/products/carroll/",
		"regex": "Product: 'carroll', Link[^>]*title=\"Version (\\d+(?:\\.\\d+)+) &middot;"
	},
	"urls": [
		"https://the-sz.com/products/carroll/history/{version}/Carroll.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://the-sz.com/common/history.php?product=carroll"
	},
	"cleanup": false
}
