{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://docs.chemaxon.com/latest/marvin_history-of-changes.html",
		"regex": ": Marvin Desktop Suite (?<version>\\d+\\.\\d+\\.\\d+)<"
	},
