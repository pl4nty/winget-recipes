{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://lizardsystems.com/lansend/releases/",
		"regex": "/lansend/releases/(\\d+(?:\\.\\d+)+)/"
	},
	"urls": ["https://lizardsystems.com/files/releases/lansend/lansend_setup_{version}.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://lizardsystems.com/lansend/releases/{version}/"
	}
}
