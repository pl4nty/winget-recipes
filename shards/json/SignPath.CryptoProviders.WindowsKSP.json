{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://docs.signpath.io/changelog",
		"regex": "/cryptoproviders/windows-ksp/(\\d+\\.\\d+\\.\\d+)/x64/SignPath\\.Windows\\.KSP\\.msi"
