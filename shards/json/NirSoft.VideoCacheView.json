{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.nirsoft.net/utils/video_cache_view.html",
		"regex": "Versions? History</h4>\\s*<ul[^>]*>\\s*<li>Version (?<version>\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{
			"url": "https://www.nirsoft.net/utils/videocacheview_setup.exe",
			"architecture": "x86"
		},
		{
			"url": "https://www.nirsoft.net/utils/videocacheview.zip",
			"architecture": "x86"
		},
		"https://www.nirsoft.net/utils/videocacheview-x64.zip"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.nirsoft.net/utils/video_cache_view.html#:~:text=Versions%20History"
	},
	"replace": true
}
