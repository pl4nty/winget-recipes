{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://raw.githubusercontent.com/revoconner/Headless-TTY/HEAD/src/main.cpp",
		"regex": "headless-tty v(\\d+(?:\\.\\d+)+) - "
	},
