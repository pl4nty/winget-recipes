{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://crystalidea.com/speedyfox",
		"regex": "Version (\\d+(?:\\.\\d+)+)\\. <a href=\"/speedyfox/release-notes\">"
	},
	"urls": ["https://crystalidea.com/downloads/speedyfox.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://crystalidea.com/speedyfox/release-notes"
	},
	"replace": true
}
