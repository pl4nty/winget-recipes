{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://www.gadwin.com/download/wssetup.exe"
		],
		"regex": "/WebSnapshot(?<major>\\d)(?<minor>\\d+)_Setup\\.zip$"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": [
		"https://www.gadwin.com/download/WebSnapshot{captures.major}{captures.minor}_Setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.gadwin.com/websnapshot/"
	}
}
