{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.netlogger.org/download.php",
		"regex": "NetLogger_(\\d+(?:\\.\\d+)+)_Windows_x86\\.msi"
	},
