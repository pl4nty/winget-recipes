{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://wubi.sogou.com/",
		"regex": "(?<url>https://ime-sec\\.gtimg\\.com/[^\"\\'\\s]+/sogou_wubi_(?<name>[\\w.]+)\\.exe)"
	},
	"version": {
		"source": "file"
	},
	"urls": [
		{
			"url": "{captures.url}",
			"architecture": "x86"
		},
		{
			"url": "{captures.url}",
			"architecture": "x64"
		},
		{
			"url": "{captures.url}",
			"architecture": "arm"
		},
		{
			"url": "{captures.url}",
			"architecture": "arm64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://wubi.sogou.com/log.php"
	},
	"replace": true,
	"state": {
		"source": "value",
		"value": "{captures.name}"
	}
}
