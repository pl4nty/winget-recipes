{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.logger32.net/",
		"regex": "href=\"https://www1\\.logger32\\.net/files/Logger32 v(\\d+\\.\\d+) Full Install\\.exe\""
	},
	"version": {
		"source": "display"
	},
	"urls": ["https://www1.logger32.net/files/Logger32%20v{version}%20Full%20Install.exe"],
