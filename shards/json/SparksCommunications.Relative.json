{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.csparks.com/Relative/index.html",
		"regex": "RelativeSetup-(\\d+(?:\\.\\d+)+)\\.exe"
