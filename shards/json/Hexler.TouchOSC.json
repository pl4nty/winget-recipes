{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://hexler.net/touchosc#get",
		"regex": "/pub/touchosc/touchosc\\-(\\d+(?:\\.\\d+)+)\\-win\\-x64\\.exe"
	},
	"urls": [
