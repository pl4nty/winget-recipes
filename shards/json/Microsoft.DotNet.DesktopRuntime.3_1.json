{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "json",
	"json": {
		"url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/3.1/releases.json",
		"path": "latest-runtime"
	},
	"urls": [
		{
			"url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/{version}/windowsdesktop-runtime-{version}-win-x64.exe",
			"architecture": "x64"
		},
		{
			"url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/{version}/windowsdesktop-runtime-{version}-win-x86.exe",
			"architecture": "x86"
		}
	]
}
