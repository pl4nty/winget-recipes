{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.getdante.com/support/software-downloads/",
		"regex": "DanteVirtualSoundcard/(?<major>\\d+)/(?<minor>\\d+\\.\\d+)/DVS-(?<version>\\d+(?:\\.\\d+)+)_windows\\.exe"
	},
	"urls": [
		"https://audinate-software-updates.sgp1.cdn.digitaloceanspaces.com/DanteVirtualSoundcard/{captures.major}/{captures.minor}/DVS-{version}_windows.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.getdante.com/releases/dante-virtual-soundcard/windows/dante-virtual-soundcard-v{version|.|-}-windows/"
	}
}
