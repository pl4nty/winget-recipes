{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://account.eiffel.com/downloads",
		"regex": "EiffelStudio/(?<version>\\d+\\.\\d+)/(?<rev>\\d+)/Eiffel_\\d+\\.\\d+_rev_\\d+-win64\\.msi"
	},
	"urls": [
		{
			"url": "https://www.eiffel.com/cdn/EiffelStudio/{version}/{captures.rev}/Eiffel_{version}_rev_{captures.rev}-win64.msi",
			"architecture": "x64"
		}
	]
}
