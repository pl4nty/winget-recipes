{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "kiwix",
		"repo": "kiwix-js-pwa",
		"method": "api-sort",
		"tagRegex": "^v(?=\\d+(?:\\.\\d+)+$)"
	},
	"urls": [
		"https://github.com/kiwix/kiwix-js-pwa/releases/download/{github.rawTag}/Kiwix-JS-Electron-Setup-{github.version}-E.exe"
	],
	"version": "{version}-E"
}
