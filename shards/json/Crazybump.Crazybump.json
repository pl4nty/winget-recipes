{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "http://crazybump.com/",
		"regex": "release/CrazyBumpSetup(?<major>\\d)(?<minor>\\d+)\\.exe"
	},
	"version": "{captures.major}.{captures.minor}",
	"urls": ["http://crazybump.com/release/CrazyBumpSetup{captures.major}{captures.minor}.exe"]
}
