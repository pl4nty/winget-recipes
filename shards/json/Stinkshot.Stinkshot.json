{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://stinkshot.com/",
		"regex": "/download/Stinkshot-(?<version>\\d+(?:\\.\\d+)+)-x64-setup\\.exe"
	},
	"urls": ["https://stinkshot.com/download/Stinkshot-{version}-x64-setup.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://code.mccullough.dev/christian/stinkshot/src/branch/main/CHANGELOG.md"
	}
}
