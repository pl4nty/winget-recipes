{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.veeam.com/kb2683",
		"regex": "<td[^>]*>(?<version>(?<major>\\d+)\\.\\d+\\.\\d+\\.\\d+)</td>\\s*<td[^>]*>\\d{4}-\\d{2}-\\d{2}</td>\\s*<td[^>]*>\\s*<a href=\"(?<notes>[^\"#]+)"
	},
	"urls": [
		{
			"url": "https://download2.veeam.com/VAW/v{captures.major}/VeeamAgentWindows_{version}_wg.exe",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "{captures.notes}"
	}
}
