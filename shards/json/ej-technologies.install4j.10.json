{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.ej-technologies.com/install4j/changelog",
		"regex": "id=\"(10\\.\\d+\\.\\d+)\""
	},
	"urls": [
		"https://download.ej-technologies.com/install4j/install4j_windows-x64_{version|.|_}.exe",
		"https://download.ej-technologies.com/install4j/install4j_windows-arm64_{version|.|_}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ej-technologies.com/install4j/changelog#{version}"
	}
}
