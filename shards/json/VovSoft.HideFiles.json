{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/hide-files/",
		"regex": "<span class=\"notranslate\">Hide Files (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/hide-files.exe"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/hide-files/"
	}
}
