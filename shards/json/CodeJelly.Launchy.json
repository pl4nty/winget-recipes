{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.launchy.net/download.php",
		"regex": "href=\"downloads/win/Launchy(?<file>\\d+(?:\\.\\d+)+)\\.exe\"[^>]*>[\\s\\S]{0,200}?Latest Stable Version \\((?<version>\\d+(?:\\.\\d+)+)\\)"
	},
	"version": "{version}.0",
	"urls": ["https://www.launchy.net/downloads/win/Launchy{captures.file}.exe"]
}
