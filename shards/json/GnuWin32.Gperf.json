{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/gnuwin32/rss?path=/gperf",
		"regex": "/gnuwin32/files/gperf/(?<version>\\d+(?:\\.\\d+)+(?:-\\d+)?)/gperf-\\k<version>\\.exe/download"
	},
	"urls": [
		"https://sourceforge.net/projects/gnuwin32/files/gperf/{version}/gperf-{version}.exe/download"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://gnuwin32.sourceforge.net/packages/gperf.htm"
	}
}
