{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://opensearch.org/downloads/",
		"regex": "opensearch-sql-odbc-driver-64-bit-(\\d+(?:\\.\\d+){3})-Windows\\.msi"
	},
	"urls": [
		"https://artifacts.opensearch.org/opensearch-clients/odbc/opensearch-sql-odbc-driver-64-bit-{version}-Windows.msi",
		"https://artifacts.opensearch.org/opensearch-clients/odbc/opensearch-sql-odbc-driver-32-bit-{version}-Windows.msi"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://github.com/opensearch-project/sql-odbc/releases/tag/{version}"
	}
}
