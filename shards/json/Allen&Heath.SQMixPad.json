{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.allen-heath.com/hardware/sq/sq-mixpad/",
		"regex": "content/uploads/(?<path>\\d{4}/\\d{2})/SQ-MixPad-(?<version>\\d+(?:\\.\\d+)+)-Installer\\.zip"
	},
