{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://sourceforge.net/projects/gnuwin32/rss?path=/flex",
		"regex": "/files/flex/(?<version>\\d[^/]*?)-(?<build>\\d+)/flex-\\k<version>-\\k<build>\\.exe/download"
	},
	"urls": [
		"https://sourceforge.net/projects/gnuwin32/files/flex/{version}-{captures.build}/flex-{version}-{captures.build}.exe/download"
	]
}
