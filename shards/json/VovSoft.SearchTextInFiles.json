{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://vovsoft.com/version-history/search-text-in-files/",
		"regex": "<span class=\"notranslate\">Search Text In Files (?<version>\\d+\\.\\d+)</span>"
	},
	"version": "{version}.0.0",
	"urls": ["https://files.vovsoft.com/search-text-in-files.exe", "https://files.vovsoft.com/search-text-in-files-portable.zip"],
	"releaseNotes": {
		"releaseNotesUrl": "https://vovsoft.com/version-history/search-text-in-files/"
	}
}
