{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://static.idriveonlinebackup.com/downloads/version_win.js",
		"regex": "win_ver=\"Version (?<version>\\d+(?:\\.\\d+)+)\"[\\s\\S]*?/downloads/(?<dir>\\d+)/IDriveWinSetup\\.exe"
	},
	"urls": [
		{
			"url": "https://static.idriveonlinebackup.com/downloads/msi/{captures.dir}/IDriveWinSetup.msi",
			"architecture": "x86"
		},
		{
			"url": "https://static.idriveonlinebackup.com/downloads/{captures.dir}/IDriveWinSetup.exe",
			"architecture": "x86"
		}
	]
}
