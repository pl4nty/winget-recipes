{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://tkengineering.fi/product/cantrace-can-bus-analyzer-software",
		"regex": "tketechnology\\.com/(?<path>wp-content/uploads/sites/\\d+/\\d{4}/\\d{2})/CANtrace-(?<version>\\d+(?:\\.\\d+)+)\\.zip"
	},
	"version": "{version}.0",
	"urls": [
		{
			"url": "https://tketechnology.com/{captures.path}/CANtrace-{version}.zip",
			"nestedInstallerMatches": ["CANtrace-setup-"]
		}
	]
}
