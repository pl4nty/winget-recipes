{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "AdoptOpenJDK",
		"repo": "openjdk8-binaries",
		"method": "api-list",
		"tagRegex": "^jdk8u(?=\\d+-b\\d+$)",
		"perPage": 100
	},
	"version": "8.0.{version|-b|.}",
	"urls": [
		"https://github.com/AdoptOpenJDK/openjdk8-binaries/releases/download/{github.rawTag}/OpenJDK8U-jdk_x64_windows_hotspot_8u{version|-|}.msi",
		"https://github.com/AdoptOpenJDK/openjdk8-binaries/releases/download/{github.rawTag}/OpenJDK8U-jdk_x86-32_windows_hotspot_8u{version|-|}.msi"
	]
}
