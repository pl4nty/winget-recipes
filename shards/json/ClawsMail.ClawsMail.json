{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.claws-mail.org/win32/",
		"regex": "claws-mail-(\\d+(?:\\.\\d+)+-\\d+)-64bit\\.exe"
	},
	"urls": [
		"https://www.claws-mail.org/win32/claws-mail-{version}-64bit.exe",
		"https://www.claws-mail.org/win32/claws-mail-{version}-32bit.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.claws-mail.org/news.php"
	}
}
