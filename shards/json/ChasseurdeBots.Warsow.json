{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://warsow.net/bundles/client.bundle.js",
		"regex": "warsow-(?<version>\\d+(?:\\.\\d+)+)-setup\\.exe"
	},
	"urls": [{ "url": "https://warsow.net/warsow-{version}-setup.exe", "architecture": "x64" }]
}
