{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "DrewNaylor",
		"repo": "guinget",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "-(?:alpha|beta)$"
	},
	"urls": [
		"https://github.com/DrewNaylor/guinget/releases/download/{github.rawTag}/guinget_{github.rawTag}.exe"
	]
}
