{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://raincleaner.eu/driver",
		"regex": "/download/driver/RainDriver-(?<version>\\d+(?:\\.\\d+)+)-win10-11-x64\\.exe"
	},
	"urls": [
		"https://raincleaner.eu/download/driver/RainDriver-{version}-win10-11-x64.exe",
		"https://raincleaner.eu/download/driver/RainDriver-{version}-win10-x86.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://raincleaner.eu/changelog"
	}
}
