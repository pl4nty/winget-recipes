{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "json",
	"json": {
		"url": "https://git.eden-emu.dev/api/v1/repos/eden-emu/eden/releases?limit=1&draft=false&pre-release=false",
		"path": "0.tag_name"
	},
	"urls": [
		"https://stable.eden-emu.dev/v{version}/Eden-Windows-v{version}-amd64-gcc-standard.zip",
		"https://stable.eden-emu.dev/v{version}/Eden-Windows-v{version}-arm64-clang-standard.zip"
	],
	"releaseNotes": {
		"source": "json",
		"sourceUrl": "https://git.eden-emu.dev/api/v1/repos/eden-emu/eden/releases/tags/v{version}",
		"path": "body",
		"nestedSource": "markdown",
		"releaseNotesUrl": "https://git.eden-emu.dev/eden-emu/eden/releases/tag/v{version}",
		"cleanup": false
	}
}
