{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.osforensics.com/tools/write-usb-images.html",
		"regex": "[Vv](?<major>\\d+\\.\\d+)(?:\\.|[\\s\\S]{0,60}?[Bb]uild\\s*)(?<build>\\d+)"
	},
	"version": "{captures.major}.{captures.build}",
	"urls": [
		"https://www.osforensics.com/downloads/imageusb.zip"
	],
	"state": {
		"source": "response-header",
		"url": "https://www.osforensics.com/downloads/imageusb.zip",
		"header": "etag"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://www.osforensics.com/tools/write-usb-images.html"
	},
	"replace": true
}
