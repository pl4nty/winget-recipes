{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.passmark.com/products/keytest/",
		"regex": "(?:\\b[Vv]|Version(?:\\s|<[^>]*>)*)(?<major>\\d+\\.\\d+)(?:\\.|[\\s\\S]{0,60}?[Bb]uild\\s*)(?<build>\\d+)"
	},
	"version": "{captures.major}.{captures.build}",
	"urls": [
		"https://www.passmark.com/downloads/keyboardtest.exe"
	],
	"state": {
		"source": "response-header",
		"url": "https://www.passmark.com/downloads/keyboardtest.exe",
		"header": "etag"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://www.passmark.com/products/keytest/"
	},
	"replace": true
}
