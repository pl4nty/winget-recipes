{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "prayag17",
		"repo": "Blink",
		"method": "api-list",
		"kind": "all",
		"tagRegex": "^(?=v\\d+(?:\\.\\d+)+-alpha\\d+$)",
		"assetRegex": "^Blink_[^/]+_x64-setup\\.exe$"
	},
	"version": "{github.rawTag}"
}
