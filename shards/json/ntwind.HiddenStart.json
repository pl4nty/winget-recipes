{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.ntwind.com/software/hstart.html",
		"regex": "Hstart_(?<version>\\d+(?:\\.\\d+)+)-setup\\.exe"
	},
	"urls": [
		"https://hstart.s3.amazonaws.com/Hstart_{version}-setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.ntwind.com/software/hstart/what-is-new.html"
	}
}
