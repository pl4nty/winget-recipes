{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "scala",
		"repo": "scala",
		"method": "api-sort",
		"tagRegex": "^v(?=2\\.13\\.\\d+$)"
	},
	"version": {
		"source": "display"
	},
	"urls": [
		"https://github.com/scala/scala/releases/download/{github.rawTag}/scala-{github.version}.msi"
	]
}
