{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://ve3nea.github.io/HamCockpit/users_guide/version_history.html",
		"regex": "<h2 id=\"v\\d+[^\"]*\">V\\.(?<version>\\d+(?:\\.\\d+)+)"
	},
	"replace": true,
	"urls": [
		{
			"url": "https://ve3nea.github.io/HamCockpit/downloads/HamCockpitSetup.zip",
			"nestedInstallerMatches": [
				"HamCockpitSetup.exe"
			]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://ve3nea.github.io/HamCockpit/users_guide/version_history.html"
	}
}
