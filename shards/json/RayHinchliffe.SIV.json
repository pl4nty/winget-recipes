{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "http://rh-software.com/",
		"regex": "href=\"zip[\\\\/]siv_v(\\d+(?:\\.\\d+)+)\\.zip\""
	},
	"urls": [
		{
			"url": "http://rh-software.com/zip/siv_v{version}.zip",
			"architecture": "x86",
			"nestedInstallerMatches": ["SIV32X.exe"]
		},
		{
			"url": "http://rh-software.com/zip/siv_v{version}.zip",
			"architecture": "x64",
			"nestedInstallerMatches": ["SIV64X.exe"]
		}
	]
}
