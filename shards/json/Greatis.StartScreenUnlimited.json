{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.greatis.com/startscreenunlimited/whatsnew.html",
		"regex": "What's new in version (?<version>\\d+(?:\\.\\d+)+)</h1>"
	},
	"urls": [
		{
			"url": "https://www.greatis.com/unlimited_setup.zip",
			"nestedInstallerMatches": [
				"unlimited_setup.exe"
			]
		}
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://www.greatis.com/startscreenunlimited/whatsnew.html"
	},
	"replace": true
}
