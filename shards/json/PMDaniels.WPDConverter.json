{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://wpdconverter.com/api/download"
		],
		"regex": "/WPDConverter-(?<version>\\d+(?:\\.\\d+)+)\\.msi$"
	},
	"releaseNotes": {
		"releaseNotesUrl": "https://wpdconverter.com/release-notes"
	}
}
