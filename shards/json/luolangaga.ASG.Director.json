{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://gitee.com/api/v5/repos/luolangaga/asg-director/releases/latest",
		"regex": "releases/download/(?<tag>[^/\"]+)/Idvevent%E5%AF%BC%E6%92%AD%E7%AB%AF%20Setup%20(?<version>\\d+(?:\\.\\d+)+)\\.exe"
	},
	"urls": [
		"https://gitee.com/luolangaga/asg-director/releases/download/{captures.tag}/Idvevent%E5%AF%BC%E6%92%AD%E7%AB%AF%20Setup%20{version}.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://gitee.com/luolangaga/asg-director/releases/tag/{captures.tag}"
	}
}
