{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://cliphearth.com/download",
		"regex": "/api/download/ClipHearth-(?<version>\\d+(?:\\.\\d+)+)-win-x64-setup\\.exe"
	},
	"urls": [
		"https://cliphearth.com/downloads/ClipHearth-{version}-win-x64-setup.exe",
		"https://cliphearth.com/downloads/ClipHearth-{version}-win-x86-setup.exe"
	],
	"releaseNotes": {
		"releaseNotesUrl": "https://cliphearth.com/changelog#v{version}"
	}
}
