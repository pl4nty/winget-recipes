{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://pixso.cn/download/",
		"regex": "data-href=\"(?<url>[^\"]*/PixsoLocalFontSetup-(?<version>\\d+(?:\\.\\d+)+)\\.exe)\""
	},
	"version": "{captures.version}",
	"urls": ["{captures.url}"]
}
